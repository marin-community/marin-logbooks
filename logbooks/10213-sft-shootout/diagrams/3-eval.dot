digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.4, ranksep=0.9, pad=0.3, bgcolor="white",
         label=<<B>Agentic SFT shootout, step 3 — four screens per checkpoint, paired per-task comparisons, and what came out</B><BR/><FONT POINT-SIZE="11">One trial per task. Composite = (SWE solved + TBLite solved) / 2. Two checkpoints are compared on the same frozen tasks with a 10,000-resample bootstrap; a difference counts only when its 95% interval excludes 0. Cost about 6,070 H100-h. Stopped and written up 2026-10-24.</FONT>>, labelloc=b];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#444444"];

  ckpt [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#548235", penwidth=1.5, label=<<B>Checkpoint</B><BR/>(23 arms + 2 parents)>];
  serve [shape=box, style="rounded,filled", fillcolor="#f6f6f6", color="#777777", label=<<B>vLLM serve</B><BR/>8 H100, data-parallel 8<BR/>32k in, 8k out per call>];

  subgraph cluster_s { label=<<B>Screens</B>>; style="rounded"; color="#999999"; fontname="Helvetica"; labeljust=l;
    s1 [shape=box, style="filled", fillcolor="#eef3f8", color="#5b7fa6", label=<<B>SWE-bench Verified r100</B><BR/>mini-swe-agent, 1,800 s, 32k context<BR/><I>target</I>>];
    s2 [shape=box, style="filled", fillcolor="#eef3f8", color="#5b7fa6", label=<<B>TBLite-100</B><BR/>Terminus-2, 1,800 s, 32k context<BR/><I>target</I>>];
    s3 [shape=box, style="filled", fillcolor="#eef3f8", color="#5b7fa6", label=<<B>BFCL-Parity</B> 123 tool-calling tasks<BR/>pi agent · <I>retention</I>>];
    s4 [shape=box, style="filled", fillcolor="#eef3f8", color="#5b7fa6", label=<<B>GSM8K</B> 0-shot, thinking off<BR/>Evalchemy · <I>retention</I>>];
  }

  pair [shape=box, style="rounded,filled", fillcolor="#f6f6f6", color="#777777", label=<<B>Paired per-task test</B><BR/>arm vs its plain twin<BR/>arm vs its parent>];

  r1 [shape=note, style="filled", fillcolor="#fde9e7", color="#c0504d", label=<<B>Every GLM-traced arm below its parent</B><BR/>on both target screens; GSM8K and BFCL rise.<BR/>SWE: rarely submits, hits the 32k context.<BR/>TBLite: most losses are 1,800 s timeouts.>];
  r2 [shape=note, style="filled", fillcolor="#f6f6f6", color="#777777", label=<<B>Methods mattered little</B><BR/>only LOW relay v0.1 beat plain: SWE +8 [+1, +16],<BR/>still below its parent; on contributor rows<BR/>plain, RS-multi, recovery, plateau indistinguishable>];
  r3 [shape=note, style="filled", fillcolor="#e2efda", color="#548235", label=<<B>The rows mattered most</B><BR/>same 1,432 tasks, parent, recipe:<BR/>contributor rows beat GLM LOW rows<BR/>SWE +26 [+17, +36], TBLite +9 [+1, +17]>];
  r4 [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#548235", penwidth=1.5, label=<<B>Decision</B><BR/>no arm promoted; tournament not run;<BR/>stopped and written up (67-page report)>];

  ckpt -> serve -> s1; serve -> s2; serve -> s3; serve -> s4;
  s1 -> pair; s2 -> pair; s3 -> pair [style=dashed]; s4 -> pair [style=dashed];
  pair -> r1; pair -> r2; pair -> r3;
  r1 -> r4; r2 -> r4; r3 -> r4;
}
