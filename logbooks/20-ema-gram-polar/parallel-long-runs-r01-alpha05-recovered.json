  "collection_scripts": {
    "collect_history.py": "import datetime, hashlib, json, math\nfrom pathlib import Path\nimport wandb\nfrom wandb.apis.public.history import SampledHistoryScan\nfrom audit_subset_history import TRAIN_KEYS, FINAL_KEY\nR=Path('scratch/20261108-alpha05-artifact-audit'); out=R/'history';out.mkdir(exist_ok=True)\nnative=json.loads(Path('scratch/20261108-parallel-r01-alpha05-failure/native.json').read_text())\nrequest=json.loads((R/'request.json').read_text())\nassert native['config']['git_commit']==request['accepted_source'] and native['state']=='crashed'\napi=None\n\ndef page(kind,keys,start,stop,samples):\n global api\n cache=out/f'{kind}-{start}-{stop}.json'\n if cache.exists(): return json.loads(cache.read_text())['rows']\n guard=cache.with_suffix('.started.json')\n spec={'keys':keys,'minStep':start,'maxStep':stop,'samples':samples}\n guard.open('x').write(json.dumps({'run':native['id'],'spec':spec,'started_utc':datetime.datetime.now(datetime.UTC).isoformat()}))\n if api is None:api=wandb.Api()\n response=api.client.execute(SampledHistoryScan.QUERY,variable_values={'entity':'marin-community','project':'marin','run':native['id'],'spec':json.dumps(spec)})\n rows=response['project']['run']['sampledHistory'][0]\n cache.write_text(json.dumps({'rows':rows,'query_spec':spec,'response':response},indent=2)+'\\n')\n return rows\n\nallrows={};duplicates={};missing={}\nfor kind,keys in [('train',['global_step',*TRAIN_KEYS]),('eval',['global_step',FINAL_KEY,'_runtime'])]:\n raw=[]\n for start in range(0,37335,1000):raw.extend(page(kind,keys,start,min(start+1000,37335),1000))\n unique={};dups=[]\n for row in raw:\n  label=row['global_step'];assert isinstance(label,(int,float)) and not isinstance(label,bool) and int(label)==label and 0<=label<37335\n  if label in unique:\n   assert unique[label]==row;dups.append(label)\n  unique[label]=row\n if kind=='train':\n  for label in sorted(set(range(37335))-set(unique)):\n   found=[r for r in page('repair',keys,label,label+1,10) if r['global_step']==label]\n   if found:assert len(found)==1;unique[label]=found[0]\n for row in unique.values():\n  for key in keys:assert isinstance(row[key],(int,float)) and not isinstance(row[key],bool) and math.isfinite(row[key])\n allrows[kind]=[unique[k] for k in sorted(unique)];duplicates[kind]=dups\n missing[kind]=sorted(set(range(37335))-set(unique)) if kind=='train' else [37334] if 37334 not in unique else []\nreport={'observed_utc':datetime.datetime.now(datetime.UTC).isoformat(),'source':request['accepted_source'],'run_id':native['id'],'native_metadata_requeried':False,'state_from_cache':native['state'],'train_rows':len(allrows['train']),'eval_rows':len(allrows['eval']),'missing':missing,'identical_duplicates':duplicates,'rows':allrows,'scientifically_complete':False,'scope':'Targeted history only from original crashed run; no metadata/state poll; local recovered rows not inserted.'}\n(R/'history-audit.json').write_text(json.dumps(report,indent=2)+'\\n')\nprint(json.dumps({k:v for k,v in report.items() if k!='rows'}))\n",
    "collect_checkpoint_metadata.py": "import hashlib,json\nfrom datetime import datetime,timezone\nfrom pathlib import Path\nfrom google.cloud import storage\nfrom checkpoint_manifest import validate_manifest\nroot=Path('scratch/20261108-alpha05-artifact-audit')\nrequest=json.loads((root/'request.json').read_text())\nassert request['counter']==37335 and request['accepted_source']=='923d79510475df3ed0fef53d40b3290ae4c90fce'\nuri=request['checkpoint']\nassert uri=='gs://marin-us-central2/ema-gram-confirmation-3e18-a0.5-seed0-7ae547c11c52/2026.11.06.02/checkpoints/step-37334'\nout=root/'counter-37335-metadata'\nout.mkdir(exist_ok=True)\nclient=storage.Client()\nbucket,path=uri[5:].split('/',1)\nrecords={}\nfor name in ['metadata.json','manifest.json']:\n    cache=out/name\n    if cache.exists():\n        record=json.loads(cache.read_text())\n    else:\n        (out/(name+'.started')).open('x').write(datetime.now(timezone.utc).isoformat())\n        blob=client.bucket(bucket).get_blob(path+'/'+name)\n        if blob is None or blob.size>=1_000_000:\n            raise ValueError('Missing or oversized checkpoint metadata')\n        raw=blob.download_as_bytes(if_generation_match=blob.generation,checksum='crc32c')\n        record=dict(parsed=json.loads(raw),generation=blob.generation,sha256=hashlib.sha256(raw).hexdigest(),size=len(raw),raw_text=raw.decode(),crc32c=blob.crc32c)\n        cache.write_text(json.dumps(record,indent=2)+'\\n')\n    raw=record['raw_text'].encode()\n    assert hashlib.sha256(raw).hexdigest()==record['sha256'] and len(raw)==record['size']\n    records[name]=record\nassert records['metadata.json']['parsed']['step']==37334\nassert records['metadata.json']['parsed']['is_temporary'] is False\nvalidation=validate_manifest(records['manifest.json']['parsed'],json.loads(Path('scratch/20261105-r02-00-final-manifest.json').read_text()))\nassert len(records['manifest.json']['parsed']['arrays'])==57\nreport=dict(observed_utc=datetime.now(timezone.utc).isoformat(),status='PERMANENT_CHECKPOINT_METADATA_VALIDATED',checkpoint=uri,expected_counter=37335,accepted_source=request['accepted_source'],accepted_job=request['accepted_job'],config_sha256=request['config_sha256'],array_count=57,manifest_validation=validation,files={k:{f:r[f] for f in ['sha256','generation','size']} for k,r in records.items()},scope='Metadata only. Stored scalar counter, complete byte restore and failed-run scientific outcome remain unvalidated; scheduler failure and crashed native state are unchanged.')\n(out/'validated.json').write_text(json.dumps(report,indent=2)+'\\n')\nprint(json.dumps(report))\n",
    "read_counter.py": "from pathlib import Path\nimport json,hashlib\nimport google.auth\nfrom google.auth.transport.requests import Request\nimport tensorstore as ts\nout=Path('scratch/20261108-alpha05-artifact-audit/counter-37335-metadata')\nmetadata=json.loads((out/'validated.json').read_text())\nassert metadata['expected_counter']==37335 and metadata['status']=='PERMANENT_CHECKPOINT_METADATA_VALIDATED'\ncache=out/'counter.json'\nif cache.exists():\n    result=json.loads(cache.read_text())\nelse:\n    (out/'counter.started').open('x').write(metadata['checkpoint'])\n    creds,_=google.auth.default(scopes=['https://www.googleapis.com/auth/devstorage.read_only'])\n    creds.refresh(Request())\n    spec={'driver':'zarr3','kvstore':{'driver':'ocdbt','base':{'driver':'http','base_url':'https://storage.googleapis.com/'+metadata['checkpoint'][5:]+'/','headers':['Authorization: Bearer '+creds.token]},'path':'step'}}\n    try:arr=ts.open(spec,open=True,read=True,write=False).result().read().result()\n    except Exception as exc:raise RuntimeError(str(exc).replace(creds.token,'[REDACTED]')) from None\n    assert arr.shape==() and int(arr)==37335\n    result={'counter':int(arr),'dtype':str(arr.dtype),'shape':list(arr.shape),'scalar_sha256':hashlib.sha256(arr.tobytes()).hexdigest(),'checkpoint':metadata['checkpoint'],'scope':'Read-only stored scalar counter; no full checkpoint byte audit or restore.'}\n    cache.write_text(json.dumps(result,indent=2)+'\\n')\nassert result['counter']==37335\nprint(json.dumps(result))\n"
