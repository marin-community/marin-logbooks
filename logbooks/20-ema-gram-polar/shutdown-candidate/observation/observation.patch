-    if len(sys.argv) > 1:
+    if len(sys.argv) > 1 and sys.argv[1] == "--observed-child":
+        mode, output = sys.argv[2:]
+        stream = Path(output).open("x")
+        # Register close first: Python calls it after the installed finalizer.
+        # On os._exit the explicit per-record flush preserves preceding events.
+        atexit.register(stream.close)
+        sequence = [0]
+
+        def sink(event, fields):
+            if mode != "clean" and event == "hook_return":
+                raise OSError("PRIVATE_SENTINEL_NOT_FOR_LOGGING")
+            if mode == "application_and_sink_failure" and event == "protocol_error":
+                raise OSError("PRIVATE_SENTINEL_NOT_FOR_LOGGING")
+            stream.write(json.dumps({"seq": sequence[0], "event": event, "fields": fields}) + "\n")
+            stream.flush()
+            sequence[0] += 1
+
+        ns, effects = load(atexit, Coordinator(), exit_fn=os._exit)
+        ns["install_coordinated_iris_finalizer"](
+            good(),
+            application_error=SystemExit(9) if mode == "application_and_sink_failure" else None,
+            health_timeout_ms=120000,
+            observation=core.FinalizationObservation(sink),
+        )
+    elif len(sys.argv) > 1:
