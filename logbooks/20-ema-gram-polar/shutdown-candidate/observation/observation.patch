+    def test_observation_failure_still_shuts_down_and_fails_task(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator())
+
+        def broken_sink(event, fields):
+            raise OSError("injected local disk failure")
+
+        ns["install_coordinated_iris_finalizer"](
+            good(),
+            application_error=None,
+            health_timeout_ms=120000,
+            observation=core.FinalizationObservation(broken_sink),
+        )
+        with self.assertRaises(Exited) as raised:
+            h.run()
+        self.assertEqual(raised.exception.code, 1)
+        self.assertEqual(events, ["shutdown"])
+
+    def test_observation_failure_preserves_application_exit(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator())
+
+        def broken_sink(event, fields):
+            raise OSError("injected local disk failure")
+
+        ns["install_coordinated_iris_finalizer"](
+            good(),
+            application_error=SystemExit(9),
+            health_timeout_ms=120000,
+            observation=core.FinalizationObservation(broken_sink),
+        )
+        with self.assertRaises(Exited) as raised:
+            h.run()
+        self.assertEqual(raised.exception.code, 9)
+        self.assertEqual(events, ["shutdown"])
+
+    def test_hook_trace_contains_read_ack_before_shutdown(self):
+        h = Hooks()
+        ns, effects = load(h, Coordinator())
+        records = []
+        ns["install_coordinated_iris_finalizer"](
+            good(),
+            application_error=None,
+            health_timeout_ms=120000,
+            observation=core.FinalizationObservation(lambda event, fields: records.append((event, fields))),
+        )
+        h.run()
+        names = [event for event, _ in records]
+        self.assertLess(names.index("receipt_read_return"), names.index("read_return"))
+        self.assertLess(names.index("read_return"), names.index("shutdown_enter"))
+        self.assertEqual(names[-1], "hook_return")
+        self.assertEqual(effects, ["shutdown"])
+
+    def test_final_observation_failure_cannot_leave_successful_exit(self):
+        h = Hooks()
+        ns, effects = load(h, Coordinator())
+
+        def sink(event, fields):
+            if event == "hook_return":
+                raise OSError("injected final write failure")
+
+        ns["install_coordinated_iris_finalizer"](
+            good(), application_error=None, health_timeout_ms=120000, observation=core.FinalizationObservation(sink)
+        )
+        with self.assertRaises(Exited) as raised:
+            h.run()
+        self.assertEqual(raised.exception.code, 1)
+        self.assertEqual(effects, ["shutdown"])
+
+    def test_protocol_error_survives_error_observation_failure(self):
+        original = TimeoutError("injected coordinator error")
+
+        class BrokenCoordinator(Coordinator):
+            def wait_at_barrier(self, key, timeout, processes):
+                raise original
+
+        def sink(event, fields):
+            if event == "protocol_error":
+                raise OSError("injected disk failure")
+
+        effects = []
+        with self.assertRaises(TimeoutError) as raised:
+            core.finalize_and_shutdown(
+                BrokenCoordinator(),
+                world_key="test",
+                rank=0,
+                ranks=(0,),
+                required_complete=True,
+                application_failed=False,
+                health_timeout_ms=120000,
+                shutdown=lambda: effects.append("shutdown"),
+                observation=core.FinalizationObservation(sink),
+            )
+        self.assertIs(raised.exception, original)
+        self.assertEqual(effects, [])
+
+    def test_registration_failure_propagates_and_allows_clean_retry(self):
+        class RegistrationFailureHooks(Hooks):
+            fail_next = False
+
+            def register(self, fn, *args):
+                if self.fail_next:
+                    self.fail_next = False
+                    raise OSError("injected registration failure")
+                return super().register(fn, *args)
+
+        handlers = RegistrationFailureHooks()
+        ns, effects = load(handlers, Coordinator())
+        handlers.register(ns["_finalize_iris_jax_after_clean_exit"], lambda: effects.append("forced_complete"))
+        handlers.fail_next = True
+        with self.assertRaises(OSError):
+            ns["install_coordinated_iris_finalizer"](good(), application_error=None, health_timeout_ms=120000)
+        # An uncaught installer error must not turn the old handler into a
+        # successful completion. Its original application-error guard remains.
+        ns["sys"].last_exc = OSError("injected registration failure")
+        handlers.run()
+        self.assertEqual(effects, [])
+        ns["sys"].last_exc = None
+        ns["install_coordinated_iris_finalizer"](good(), application_error=None, health_timeout_ms=120000)
+        handlers.run()
+        self.assertEqual(effects, ["shutdown"])
+
     def test_duplicate_install_does_not_duplicate_shutdown(self):
