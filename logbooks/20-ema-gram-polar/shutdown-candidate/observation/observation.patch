+    def test_observed_atexit_persists_order_and_failure_codes(self):
+        for mode, expected_code in [("clean", 0), ("sink_failure", 1), ("application_and_sink_failure", 9)]:
+            with self.subTest(mode=mode), tempfile.TemporaryDirectory() as folder:
+                path = Path(folder) / "trace.jsonl"
+                p = subprocess.run(
+                    [sys.executable, __file__, "--observed-child", mode, str(path)], capture_output=True
+                )
+                self.assertEqual(p.returncode, expected_code)
+                records = [json.loads(line) for line in path.read_text().splitlines()]
+                names = [row["event"] for row in records]
+                self.assertLess(names.index("read_return"), names.index("shutdown_enter"))
+                self.assertLess(names.index("shutdown_enter"), names.index("shutdown_return"))
+                self.assertEqual(names[-1], "hook_return" if mode == "clean" else "shutdown_return")
+                self.assertEqual([row["seq"] for row in records], list(range(len(records))))
+                self.assertNotIn(b"PRIVATE_SENTINEL_NOT_FOR_LOGGING", p.stderr)
+
     def test_actual_process_exit_failure_code(self):
