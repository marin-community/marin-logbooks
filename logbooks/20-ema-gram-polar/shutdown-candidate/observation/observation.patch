@@ -5,6 +5,7 @@
 
 from collections.abc import Callable, Sequence
 import json
+import hashlib
 from typing import Protocol
 
 
@@ -20,6 +21,33 @@ class DistributedFinalizationError(RuntimeError):
     pass
 
 
+class FinalizationObservation:
+    """Record local boundaries without abandoning cleanup on a sink failure.
+
+    The sink must only append local diagnostics; it must not use JAX or network
+    services. Writes can block, so observation is not timing-neutral.
+    """
+
+    def __init__(self, sink: Callable[[str, dict[str, object]], None] | None = None):
+        self.sink = sink
+        self.failure_type: str | None = None
+
+    def emit(self, event: str, **fields: object) -> None:
+        if self.sink is None or self.failure_type is not None:
+            return
+        try:
+            self.sink(event, fields)
+        except BaseException as error:
+            # Keep the first failure; recursive error reporting could fail too.
+            self.failure_type = type(error).__name__
+
+    def require_complete(self) -> None:
+        if self.failure_type is not None:
+            raise DistributedFinalizationError(
+                f"local finalization observation failed ({self.failure_type})"
+            ) from None
+
+
 def finalize_and_shutdown(
     coordinator: FinalizationCoordinator,
     *,
@@ -30,6 +58,7 @@ def finalize_and_shutdown(
     application_failed: bool,
     health_timeout_ms: int,
     shutdown: Callable[[], None],
+    observation: FinalizationObservation | None = None,
 ) -> None:
     """Wait for drain outcomes, shut down together, and preserve required failures.
 
@@ -39,23 +68,44 @@ def finalize_and_shutdown(
     The caller must keep that failure nonzero; real JAX cleanup on this path
     requires runtime qualification. No force-completion operation is performed.
     """
+    observation = observation if observation is not None else FinalizationObservation()
     prefix = f"levanter/finalization/v1/{world_key}/"
     payload = {"required_complete": required_complete, "application_failed": application_failed}
-    coordinator.key_value_set(f"{prefix}{rank}", json.dumps(payload))
-    coordinator.wait_at_barrier(f"{prefix}ready", health_timeout_ms, ranks)
-    receipts = {
-        int(key.removeprefix(prefix)): json.loads(value) for key, value in coordinator.key_value_dir_get(prefix)
-    }
-    if set(receipts) != set(ranks):
-        raise DistributedFinalizationError("rank receipt membership does not match the execution")
-    failed = any(
-        receipt.get("required_complete") is not True or receipt.get("application_failed") is not False
-        for receipt in receipts.values()
-    )
-    # A fast coordinator rank must not tear down its service while a slower
-    # peer is still fetching receipts. Ready means all writes exist; this
-    # second rendezvous means every rank has read and validated them.
-    coordinator.wait_at_barrier(f"{prefix}read", health_timeout_ms, ranks)
-    shutdown()
-    if failed:
-        raise DistributedFinalizationError("application or required telemetry failed on one or more ranks")
+    encoded = json.dumps(payload)
+    try:
+        observation.emit("receipt_write_enter", key=f"{prefix}{rank}")
+        coordinator.key_value_set(f"{prefix}{rank}", encoded)
+        observation.emit(
+            "receipt_write_return", key=f"{prefix}{rank}", value_sha256=hashlib.sha256(encoded.encode()).hexdigest()
+        )
+        observation.emit("ready_enter", key=f"{prefix}ready")
+        coordinator.wait_at_barrier(f"{prefix}ready", health_timeout_ms, ranks)
+        observation.emit("ready_return", key=f"{prefix}ready")
+        observation.emit("receipt_read_enter", prefix=prefix)
+        records = coordinator.key_value_dir_get(prefix)
+        observation.emit(
+            "receipt_read_return",
+            keys=[key for key, _ in records],
+            value_sha256=[hashlib.sha256(value.encode()).hexdigest() for _, value in records],
+        )
+        receipts = {int(key.removeprefix(prefix)): json.loads(value) for key, value in records}
+        if set(receipts) != set(ranks):
+            raise DistributedFinalizationError("rank receipt membership does not match the execution")
+        failed = any(
+            receipt.get("required_complete") is not True or receipt.get("application_failed") is not False
+            for receipt in receipts.values()
+        )
+        # Ready establishes writes; read acknowledges that every rank consumed
+        # them before the coordinator rank can tear down the service.
+        observation.emit("read_enter", key=f"{prefix}read")
+        coordinator.wait_at_barrier(f"{prefix}read", health_timeout_ms, ranks)
+        observation.emit("read_return", key=f"{prefix}read")
+        observation.emit("shutdown_enter")
+        shutdown()
+        observation.emit("shutdown_return")
+        if failed:
+            raise DistributedFinalizationError("application or required telemetry failed on one or more ranks")
+    except BaseException as error:
+        observation.emit("protocol_error", error_type=type(error).__name__)
+        raise
+    observation.require_complete()
