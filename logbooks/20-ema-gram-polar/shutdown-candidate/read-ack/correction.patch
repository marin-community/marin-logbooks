     scripts = [
         root / "lib/levanter/tests/shutdown_candidate_checks" / f"check_{name}_integration.py"
-        for name in ["source", "backend", "hook", "trainer_exit"]
+        for name in ["source", "backend", "hook", "trainer_exit", "read_ack"]
     ] + [Path(__file__).with_name("check_entrypoint_integration.py")]
