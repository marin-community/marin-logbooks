+
+class Sink(t.NoopTracker):
+    def __init__(self, name, fail=None):
+        self.name = name
+        self.fail = fail
+        self.finished = False
+        self.rows = []
+
+    def log(self, metrics, **kwargs):
+        if self.fail == "log":
+            raise OSError("injected sink log failure")
+        self.rows.append(metrics)
+
+    def finish(self):
+        if self.fail == "finish":
+            raise OSError("injected sink finish failure")
+        self.finished = True
+
+
+class Checks(unittest.TestCase):
+    def required(self, report):
+        return f.required_sinks_complete(report, frozenset({"wandb"}))
+
+    def test_actual_composition_preserves_required_success_and_aux_failure(self):
+        w = Sink("wandb")
+        aux = Sink("telemetry", "finish")
+        report = t.CompositeTracker([b.BackgroundTracker(w, finish_timeout=5), aux]).finish_with_report()
+        self.assertTrue(self.required(report))
+        self.assertTrue(w.finished)
+        self.assertEqual(report.children[1].state, f.FinalizationState.INCOMPLETE)
+
+    def test_required_sink_failure_does_not_skip_other_backends(self):
+        w = Sink("wandb", "finish")
+        aux = Sink("json")
+        report = t.CompositeTracker([b.BackgroundTracker(w, finish_timeout=5), aux]).finish_with_report()
+        self.assertFalse(self.required(report))
+        self.assertTrue(aux.finished)
+        self.assertEqual(report.children[0].failed_calls, 1)
+
+    def test_prior_log_failure_is_not_erased_by_finish(self):
+        w = Sink("wandb", "log")
+        bg = b.BackgroundTracker(w, finish_timeout=5)
+        bg.log({"loss": 1.0}, step=0)
+        report = t.CompositeTracker([bg]).finish_with_report()
+        self.assertTrue(w.finished)
+        self.assertFalse(self.required(report))
+        self.assertEqual(report.children[0].failed_calls, 1)
+
+    def test_plain_return_is_unverified_for_required_sink(self):
+        w = Sink("wandb")
+        report = t.CompositeTracker([w]).finish_with_report()
+        self.assertTrue(w.finished)
+        self.assertFalse(self.required(report))
+        self.assertEqual(report.children[0].state, f.FinalizationState.UNVERIFIED)
+
+    def test_nested_composition_keeps_required_failure(self):
+        aux = Sink("json")
+        w = Sink("wandb", "finish")
+        report = t.CompositeTracker(
+            [t.CompositeTracker([b.BackgroundTracker(w, finish_timeout=5)]), aux]
+        ).finish_with_report()
+        self.assertTrue(aux.finished)
+        self.assertFalse(self.required(report))
+        self.assertEqual(len(report.leaves()), 2)
+
+    def test_enqueue_admission_is_atomic_with_finish(self):
+        sink = Sink("wandb")
+        bg = b.BackgroundTracker(sink, finish_timeout=5)
+        producer_entered = threading.Event()
+        release_producer = threading.Event()
+        finalizer_entered = threading.Event()
+        original_lock = bg._lock
+
+        class ObservedLock:
+            def __enter__(self):
+                if threading.current_thread().name == "test-finalizer":
+                    finalizer_entered.set()
+                original_lock.acquire()
+                return self
+
+            def __exit__(self, *args):
+                original_lock.release()
+
+        bg._lock = ObservedLock()
+        original_put = bg._queue.put_nowait
+
+        def gated_put(item):
+            if threading.current_thread().name == "test-producer":
+                producer_entered.set()
+                if not release_producer.wait(5):
+                    raise RuntimeError("test gate not released")
+            return original_put(item)
+
+        bg._queue.put_nowait = gated_put
