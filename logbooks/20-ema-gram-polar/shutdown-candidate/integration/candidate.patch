+        finalizer = threading.Thread(name="test-finalizer", target=bg.finish)
+        producer.start()
+        try:
+            self.assertTrue(producer_entered.wait(5))
+            finalizer.start()
+            self.assertTrue(finalizer_entered.wait(5))
+            # Finalizer has attempted the lock; admission still owns it.
+            self.assertFalse(bg._stopped)
+        finally:
+            release_producer.set()
+            producer.join(5)
+            if finalizer.ident is not None:
+                finalizer.join(5)
+            else:
+                bg.finish()
+        self.assertFalse(producer.is_alive())
+        self.assertFalse(finalizer.is_alive())
