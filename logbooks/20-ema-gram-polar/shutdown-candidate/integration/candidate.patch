+# Copyright The Levanter Authors
+# SPDX-License-Identifier: Apache-2.0
+
+# Copyright The Marin Authors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Actual Trainer exit method with non-numerical fake cleanup boundaries."""
+import ast
+from contextlib import contextmanager
+import json
+import os
+import logging
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+ROOT = next(parent for parent in Path(__file__).resolve().parents if (parent / "lib/levanter/src/levanter").is_dir())
+SOURCE = ROOT / "lib/levanter/src/levanter/trainer.py"
+logging.disable(logging.CRITICAL)
+
+
+@contextmanager
+def progress_event_scope(emit, start, end):
+    emit(start)
+    try:
+        yield
+    finally:
+        emit(end)
+
+
+ns = dict(
+    progress_event_scope=progress_event_scope,
+    ProgressEvent=SimpleNamespace(CHECKPOINT_STARTED="start", CHECKPOINT_FINISHED="end", TRAINING_FINISHED="finished"),
+    logger=logging.getLogger("trainer-exit-check"),
+)
+cls = next(n for n in ast.parse(SOURCE.read_text()).body if isinstance(n, ast.ClassDef) and n.name == "Trainer")
+method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "__exit__")
+exec(compile(ast.Module(body=[method], type_ignores=[]), str(SOURCE), "exec"), ns)
+
+
+class FakeTrainer:
+    __exit__ = ns["__exit__"]
+
+    def __init__(self, checkpoint_error=None, context_error=None, event_error=None):
+        self.events = []
+
+        def wait():
+            self.events.append("checkpoint")
+            if checkpoint_error is not None:
+                raise checkpoint_error
+
+        def close(*args):
+            self.events.append("context")
+            if context_error is not None:
+                raise context_error
+
+        def emit(event):
+            self.events.append(event)
+            if event == "finished" and event_error is not None:
+                raise event_error
+
+        self._checkpointer = SimpleNamespace(wait_until_finished=wait)
+        self._cmanagers = [SimpleNamespace(__exit__=close), SimpleNamespace(__exit__=close)]
+        self.hooks = SimpleNamespace(emit_event=emit)
+
+    def __enter__(self):
+        return self
+
+
+class Checks(unittest.TestCase):
+    def test_success_drains_before_contexts(self):
+        trainer = FakeTrainer()
+        with trainer:
+            pass
+        self.assertEqual(trainer.events, ["start", "checkpoint", "end", "context", "context", "finished"])
+        self.assertEqual(trainer._cmanagers, [])
+
+    def test_original_application_error_survives_all_cleanup_failures(self):
+        original = ValueError("application")
+        trainer = FakeTrainer(OSError("checkpoint"), RuntimeError("context"), RuntimeError("event"))
+        with self.assertRaises(ValueError) as caught:
+            with trainer:
+                raise original
+        self.assertIs(caught.exception, original)
+        self.assertEqual(len(original.__notes__), 4)
+        self.assertEqual(trainer.events.count("context"), 2)
+        self.assertEqual(trainer._cmanagers, [])
+
+    def test_original_system_exit_code_survives_cleanup(self):
+        original = SystemExit(7)
+        with self.assertRaises(SystemExit) as caught:
+            with FakeTrainer(context_error=RuntimeError("cleanup")):
+                raise original
+        self.assertIs(caught.exception, original)
+        self.assertEqual(caught.exception.code, 7)
+
+    def test_cleanup_failure_without_application_error_stays_failure(self):
+        error = OSError("checkpoint")
