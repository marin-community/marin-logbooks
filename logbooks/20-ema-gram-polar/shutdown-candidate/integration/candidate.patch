@@ -0,0 +1,57 @@
+# Copyright The Levanter Authors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Host-side finalization exchange; remote history remains independently audited."""
+
+from collections.abc import Callable, Sequence
+import json
+from typing import Protocol
+
+
+class FinalizationCoordinator(Protocol):
+    def key_value_set(self, key: str, value: str, allow_overwrite: bool = False) -> None: ...
+
+    def key_value_dir_get(self, key: str) -> list[tuple[str, str]]: ...
+
+    def wait_at_barrier(self, barrier_id: str, timeout_in_ms: int, process_ids: Sequence[int]) -> None: ...
+
+
+class DistributedFinalizationError(RuntimeError):
+    pass
+
+
+def finalize_and_shutdown(
+    coordinator: FinalizationCoordinator,
+    *,
+    world_key: str,
+    rank: int,
+    ranks: tuple[int, ...],
+    required_complete: bool,
+    application_failed: bool,
+    health_timeout_ms: int,
+    shutdown: Callable[[], None],
+) -> None:
+    """Wait for drain outcomes, shut down together, and preserve required failures.
+
+    Call once per coordinator world, after the outer caller's final JAX uses.
+    The timeout bounds a communication-health rendezvous, not the training job.
+    On missing peers or coordinator failure, raise before calling shutdown.
+    The caller must keep that failure nonzero; real JAX cleanup on this path
+    requires runtime qualification. No force-completion operation is performed.
+    """
+    prefix = f"levanter/finalization/v1/{world_key}/"
+    payload = {"required_complete": required_complete, "application_failed": application_failed}
+    coordinator.key_value_set(f"{prefix}{rank}", json.dumps(payload))
+    coordinator.wait_at_barrier(f"{prefix}ready", health_timeout_ms, ranks)
+    receipts = {
+        int(key.removeprefix(prefix)): json.loads(value) for key, value in coordinator.key_value_dir_get(prefix)
+    }
+    if set(receipts) != set(ranks):
+        raise DistributedFinalizationError("rank receipt membership does not match the execution")
+    failed = any(
+        receipt.get("required_complete") is not True or receipt.get("application_failed") is not False
+        for receipt in receipts.values()
+    )
+    shutdown()
