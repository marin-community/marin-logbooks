+# Copyright The Levanter Authors
+# SPDX-License-Identifier: Apache-2.0
+
+# Copyright The Marin Authors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Execute candidate backend method bodies with external services replaced by fakes.
+
+Imports of heavy backend modules and constructors that initialize tracking/JAX
+are deliberately excluded. This is not a live ONLINE logging qualification.
+"""
+import ast
+from enum import StrEnum, IntEnum
+import importlib.util
+import json
+import os
+import logging
+from pathlib import Path
+import sys
+import types
+import unittest
+
+ROOT = next(parent for parent in Path(__file__).resolve().parents if (parent / "lib/levanter/src/levanter").is_dir())
+SOURCE = ROOT / "lib/levanter/src/levanter/tracker"
+for name in ("levanter", "levanter.tracker"):
+    m = types.ModuleType(name)
+    m.__path__ = []
+    sys.modules[name] = m
+jax = types.ModuleType("jax")
+jax.device_get = lambda x: x
+sys.modules["jax"] = jax
+for name in ("finalization", "tracker", "background"):
+    full = "levanter.tracker." + name
+    spec = importlib.util.spec_from_file_location(full, SOURCE / (name + ".py"))
+    m = importlib.util.module_from_spec(spec)
+    sys.modules[full] = m
+    spec.loader.exec_module(m)
+f = sys.modules["levanter.tracker.finalization"]
+t = sys.modules["levanter.tracker.tracker"]
+b = sys.modules["levanter.tracker.background"]
+logging.disable(logging.CRITICAL)
+namespace = {
+    "Tracker": t.Tracker,
+    "FinalizationReport": f.FinalizationReport,
+    "FinalizationState": f.FinalizationState,
+    "logger": logging.getLogger("isolated-backend-check"),
+    "StrEnum": StrEnum,
+    "IntEnum": IntEnum,
+}
+
+
+def load_classes(path, names):
+    tree = ast.parse(path.read_text())
+    for node in tree.body:
+        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
+            try:
+                namespace[node.targets[0].id] = ast.literal_eval(node.value)
+            except (ValueError, TypeError):
+                pass
+    nodes = [n for n in tree.body if isinstance(n, ast.ClassDef) and n.name in names]
+    assert len(nodes) == len(names)
+    module = ast.Module(
+        body=[ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0), *nodes],
+        type_ignores=[],
+    )
+    exec(compile(ast.fix_missing_locations(module), str(path), "exec"), namespace)
+
+
+load_classes(ROOT / "lib/finelog/src/finelog/client/log_client.py", {"FlushResult"})
+load_classes(SOURCE / "finelog_metrics.py", {"LevanterMetricsWriter"})
+load_classes(SOURCE / "wandb.py", {"WandbTracker"})
+load_classes(SOURCE / "telemetry.py", {"TrainingPhase", "TelemetryTracker"})
+FlushResult = namespace["FlushResult"]
+
+
+class Run:
+    def __init__(self, fail=False):
+        self.fail = fail
+        self.finished = False
+
+    def finish(self):
+        if self.fail:
+            raise ConnectionError("injected W&B I/O failure")
+        self.finished = True
+
+
+class Checks(unittest.TestCase):
+    def wandb(self, run, suppressed=False):
