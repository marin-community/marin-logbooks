new file mode 100644
index 000000000..f7109c497
--- /dev/null
+++ b/lib/levanter/src/levanter/tracker/finalization.py
@@ -0,0 +1,44 @@
+# Copyright The Levanter Authors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Local tracker finalization evidence; independent of remote history auditing."""
+
+from dataclasses import dataclass
+from enum import StrEnum
+
+
+class FinalizationState(StrEnum):
+    COMPLETE = "complete"
+    INCOMPLETE = "incomplete"
+    UNVERIFIED = "unverified"
+
+
+@dataclass(frozen=True)
+class FinalizationReport:
+    name: str
+    state: FinalizationState
+    detail: str = ""
+    failed_calls: int | None = None
+    rejected_updates: int | None = None
+    worker_alive: bool | None = None
+    children: tuple["FinalizationReport", ...] = ()
+
+    def leaves(self) -> tuple["FinalizationReport", ...]:
+        if self.children:
+            return tuple(leaf for child in self.children for leaf in child.leaves())
+        return (self,)
+
+
+def required_sinks_complete(report: FinalizationReport, required_names: frozenset[str]) -> bool:
+    """Require exactly one complete report for each required sink on this rank.
+
+    The caller selects required names from the resolved execution policy.
+    Missing, duplicate, or unverified evidence cannot satisfy that policy.
+    A complete local report still does not certify remote history integrity.
+    """
+    leaves = report.leaves()
+    for name in required_names:
+        matched = [leaf for leaf in leaves if leaf.name == name]
+        if len(matched) != 1 or matched[0].state != FinalizationState.COMPLETE:
+            return False
+    return True
