+"""Candidate exit-hook source with external JAX/coordinator/atexit boundaries faked."""
+import ast
+import atexit
+from collections.abc import Callable
+import importlib.util
+import json
+import logging
+import os
+from pathlib import Path
+import subprocess
+import sys
+from types import SimpleNamespace
+import unittest
+
+ROOT = next(parent for parent in Path(__file__).resolve().parents if (parent / "lib/levanter/src/levanter").is_dir())
+SRC = ROOT / "lib/levanter/src/levanter"
+for name, path in [
+    ("receipt", SRC / "tracker/finalization.py"),
+    ("finalize_core", SRC / "distributed_finalization.py"),
+]:
+    spec = importlib.util.spec_from_file_location(name, path)
+    m = importlib.util.module_from_spec(spec)
+    sys.modules[name] = m
+    spec.loader.exec_module(m)
+receipt = sys.modules["receipt"]
+core = sys.modules["finalize_core"]
+logging.disable(logging.CRITICAL)
+
+
+class Hooks:
+    def __init__(self):
+        self.handlers = []
+
+    def register(self, fn, *args):
+        self.handlers.append((fn, args))
+        return fn
+
+    def unregister(self, fn):
+        self.handlers = [(f, a) for f, a in self.handlers if f != fn]
+
+    def run(self):
+        for f, a in reversed(self.handlers):
+            f(*a)
+
+
+class Coordinator:
+    def __init__(self, peer_failed=False, fail=False):
+        self.data = {}
+        self.peer_failed = peer_failed
+        self.fail = fail
+
+    def key_value_set(self, k, v, allow_overwrite=False):
+        self.data[k] = v
+
+    def wait_at_barrier(self, key, timeout, processes):
+        if self.fail:
+            raise TimeoutError("injected missing peer")
+        prefix = key.removesuffix("ready")
+        for rank in processes:
+            self.data.setdefault(
+                prefix + str(rank), json.dumps({"required_complete": True, "application_failed": self.peer_failed})
+            )
+
+    def key_value_dir_get(self, prefix):
+        return [(k, v) for k, v in self.data.items() if k.startswith(prefix)]
+
+
+class Exited(BaseException):
+    def __init__(self, code):
+        self.code = code
+
+
+def load(hooks, coordinator, rank=0, exit_fn=None):
+    events = []
+
+    def shutdown():
+        events.append("shutdown")
+
+    def exit_default(code):
+        raise Exited(code)
+
+    jax = SimpleNamespace(
+        distributed=SimpleNamespace(is_initialized=lambda: True, shutdown=shutdown),
+        process_index=lambda: rank,
+        process_count=lambda: 4,
+    )
+    ns = {
+        "Callable": Callable,
+        "FinalizationReport": receipt.FinalizationReport,
+        "required_sinks_complete": receipt.required_sinks_complete,
+        "finalize_and_shutdown": core.finalize_and_shutdown,
+        "atexit": hooks,
+        "jax": jax,
+        "jax_distributed": SimpleNamespace(global_state=SimpleNamespace(client=coordinator)),
+        "sys": SimpleNamespace(last_exc=None),
+        "os": SimpleNamespace(_exit=exit_fn or exit_default),
+        "logger": logging.getLogger("hook-check"),
+        "get_job_info": lambda: SimpleNamespace(job_id=SimpleNamespace(to_wire=lambda: "local-job")),
+        "_coordinated_exit_hook": None,
+    }
+    tree = ast.parse((SRC / "distributed.py").read_text())
+    names = {
+        "_finalize_iris_jax_after_clean_exit",
+        "_unregister_iris_exit_handler",
+        "install_coordinated_iris_finalizer",
+    }
+    nodes = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in names]
+    assert len(nodes) == 3
+    mod = ast.Module(
+        body=[ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0), *nodes],
+        type_ignores=[],
+    )
+    exec(compile(ast.fix_missing_locations(mod), str(SRC / "distributed.py"), "exec"), ns)
+    return ns, events
+
+
+def good():
+    return receipt.FinalizationReport("wandb", receipt.FinalizationState.COMPLETE)
+
+
+class Checks(unittest.TestCase):
+    def test_replacement_removes_force_completion_hook(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator())
+        h.register(ns["_finalize_iris_jax_after_clean_exit"], lambda: events.append("forced_complete"))
+        ns["install_coordinated_iris_finalizer"](good(), application_error=None, health_timeout_ms=120000)
+        h.run()
+        self.assertEqual(events, ["shutdown"])
+        self.assertEqual(len(h.handlers), 1)
+
+    def test_duplicate_install_does_not_duplicate_shutdown(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator())
+        install = ns["install_coordinated_iris_finalizer"]
+        install(good(), application_error=None, health_timeout_ms=120000)
+        with self.assertRaises(RuntimeError):
+            install(good(), application_error=None, health_timeout_ms=120000)
+        h.run()
+        self.assertEqual(events, ["shutdown"])
+
+    def test_unregister_removes_candidate_hook(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator())
+        ns["install_coordinated_iris_finalizer"](good(), application_error=None, health_timeout_ms=120000)
+        ns["_unregister_iris_exit_handler"]()
+        h.run()
+        self.assertEqual(events, [])
+
+    def test_peer_application_failure_preserved_after_shutdown(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator(peer_failed=True))
+        ns["install_coordinated_iris_finalizer"](good(), application_error=None, health_timeout_ms=120000)
+        with self.assertRaises(Exited) as raised:
+            h.run()
+        self.assertEqual(raised.exception.code, 1)
+        self.assertEqual(events, ["shutdown"])
+
+    def test_local_application_exit_code_preserved(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator())
+        ns["install_coordinated_iris_finalizer"](good(), application_error=SystemExit(7), health_timeout_ms=120000)
+        with self.assertRaises(Exited) as raised:
+            h.run()
+        self.assertEqual(raised.exception.code, 7)
+        self.assertEqual(events, ["shutdown"])
+
+    def test_error_after_registration_preserves_exit_code(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator())
+        ns["install_coordinated_iris_finalizer"](good(), application_error=None, health_timeout_ms=120000)
+        ns["sys"].last_exc = SystemExit(9)
+        with self.assertRaises(Exited) as raised:
+            h.run()
+        self.assertEqual(raised.exception.code, 9)
+        self.assertEqual(events, ["shutdown"])
+
+    def test_missing_peer_fails_without_successful_shutdown(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator(fail=True))
+        ns["install_coordinated_iris_finalizer"](good(), application_error=None, health_timeout_ms=120000)
+        with self.assertRaises(Exited):
+            h.run()
+        self.assertEqual(events, [])
+
+    def test_nonpublisher_still_requires_application_report(self):
+        h = Hooks()
+        ns, events = load(h, Coordinator(), rank=1)
+        ns["install_coordinated_iris_finalizer"](None, application_error=None, health_timeout_ms=120000)
+        with self.assertRaises(Exited):
+            h.run()
+        self.assertEqual(events, ["shutdown"])
+
+    def test_actual_process_exit_failure_code(self):
+        p = subprocess.run([sys.executable, __file__, "--child"], capture_output=True)
+        self.assertEqual(p.returncode, 7)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) > 1:
+        ns, events = load(atexit, Coordinator(), exit_fn=os._exit)
+        atexit.register(ns["_finalize_iris_jax_after_clean_exit"], lambda: None)
+        ns["install_coordinated_iris_finalizer"](good(), application_error=SystemExit(7), health_timeout_ms=120000)
+    else:
+        r = unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Checks))
+        (Path(os.environ["EMA_GRAM_CHECK_RESULT_DIR"]) / "hook-integration-checks.json").write_text(
+            json.dumps(
+                {
+                    "passed": r.wasSuccessful(),
+                    "tests": r.testsRun,
+                    "scope": "actual candidate core module and three distributed hook function ASTs; external coordinator/JAX boundaries faked; one real Python atexit subprocess",
+                    "runtime_qualified": False,
+                    "new_jobs": 0,
+                    "remote_calls": 0,
+                },
+                indent=2,
+            )
+            + "\n"
+        )
+        raise SystemExit(0 if r.wasSuccessful() else 1)
