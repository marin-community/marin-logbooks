 def _unregister_iris_exit_handler() -> None:
+    global _coordinated_exit_hook
     atexit.unregister(_finalize_iris_jax_after_clean_exit)
+    if _coordinated_exit_hook is not None:
+        atexit.unregister(_coordinated_exit_hook)
+        _coordinated_exit_hook = None
+
+
+def install_coordinated_iris_finalizer(
+    report: FinalizationReport | None,
+    *,
+    application_error: BaseException | None,
+    health_timeout_ms: int,
+) -> None:
+    """Replace the default Iris exit hook after all outer-wrapper JAX work.
+
+    This candidate requires an initialized Iris JAX world. Rank zero publishes
+    W&B; the other ranks still contribute their application success/failure.
+    Natural task exits determine job status. The hook never calls complete_job.
+    """
+    global _coordinated_exit_hook
+    if _coordinated_exit_hook is not None:
+        raise RuntimeError("coordinated finalization is already installed for this world")
+    job_info = get_job_info()
+    coordinator = jax_distributed.global_state.client
+    if job_info is None or coordinator is None or not jax.distributed.is_initialized():
+        raise RuntimeError("coordinated finalization requires an initialized Iris JAX world")
+    rank = jax.process_index()
+    ranks = tuple(range(jax.process_count()))
+    # The coordinator service scopes this key to its distributed world. A fresh
+    # process attempt must initialize a fresh world, not reuse a finished one.
+    world_key = job_info.job_id.to_wire()
+    required_names = frozenset({"wandb"}) if rank == 0 else frozenset()
+    required_complete = report is not None and required_sinks_complete(report, required_names)
+
+    def finalize() -> None:
+        error = application_error if application_error is not None else getattr(sys, "last_exc", None)
+        failure_code = 1
+        if isinstance(error, SystemExit) and isinstance(error.code, int) and error.code != 0:
+            failure_code = error.code
+        try:
+            finalize_and_shutdown(
+                coordinator,
+                world_key=world_key,
+                rank=rank,
+                ranks=ranks,
+                required_complete=required_complete,
+                application_failed=error is not None,
+                health_timeout_ms=health_timeout_ms,
+                shutdown=jax.distributed.shutdown,
+            )
+        except BaseException:
+            logger.exception("Coordinated Iris finalization failed")
+            os._exit(failure_code)
+
+    _unregister_iris_exit_handler()
+    _coordinated_exit_hook = finalize
+    atexit.register(finalize)
 
 
