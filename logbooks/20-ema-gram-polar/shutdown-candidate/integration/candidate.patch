+        self.assertFalse(bg.finalization_receipt().locally_drained)
+        self.assertEqual(bg.finalization_receipt().rejected_updates, 1)
+        # An immutable earlier snapshot cannot certify later producer behavior.
+        self.assertTrue(before.locally_drained)
+
