+# Copyright The Marin Authors
+# SPDX-License-Identifier: Apache-2.0
+
+"""Execute candidate wrapper AST with fake training/JAX/storage boundaries."""
+import ast
+import importlib.util
+import json
+import os
+import sys
+import unittest
+from dataclasses import asdict, dataclass, replace
+from pathlib import Path
+from types import SimpleNamespace
+
+ROOT = next(parent for parent in Path(__file__).resolve().parents if (parent / "lib/levanter/src/levanter").is_dir())
+SOURCE = ROOT / "experiments/ema_gram/train.py"
+spec = importlib.util.spec_from_file_location("receipt", ROOT / "lib/levanter/src/levanter/tracker/finalization.py")
+receipt = importlib.util.module_from_spec(spec)
+sys.modules["receipt"] = receipt
+spec.loader.exec_module(receipt)
+
+
+@dataclass
+class Tracker:
+    id: str = "run"
+    resume: str = "never"
+    mode: str = "online"
+
+
+@dataclass
+class Trainer:
+    tracker: object
+    id: str = "run"
+
+
+@dataclass
+class TrainConfig:
+    trainer: object
+
+
+@dataclass
+class Config:
+    train_config: object
+    output_path: str = "fake-artifacts"
+
+
+def load(app_error=None, memory_error=None, install_error=None, handler_error=None):
+    events, writes, installed = [], {}, []
+
+    class FakePath:
+        def __init__(self, path):
+            self.path = str(path)
+
+        def __truediv__(self, part):
+            return FakePath(self.path + "/" + part)
+
+        def mkdir(self, **kwargs):
+            pass
+
+        def mkdirs(self):
+            pass
+
+        def write_text(self, value):
+            writes[self.path] = value
+
+    class Handler:
+        def __init__(self, *args):
+            pass
+
+        def close(self):
+            events.append("handler_close")
+            if handler_error is not None:
+                raise handler_error
+
+    logger = SimpleNamespace(
+        name="metrics",
+        addHandler=lambda h: None,
+        removeHandler=lambda h: events.append("handler_remove"),
+        info=lambda msg: None,
+        exception=lambda msg: events.append("exception_logged"),
+    )
+    good = receipt.FinalizationReport("wandb", receipt.FinalizationState.COMPLETE)
+
+    def train(config):
+        events.append("train")
+        tracker = config.train_config.trainer.tracker[0]
+        assert tracker.mode == "online" and tracker.resume == "never"
+        if app_error is not None:
+            raise app_error
+        return good
+
+    def memory():
+        events.append("memory")
+        if memory_error is not None:
+            raise memory_error
+        return {"bytes": 1}
+
+    def install(report, **kwargs):
+        events.append("install")
+        installed.append((report, kwargs))
+        if install_error is not None:
+            raise install_error
+
+    ns = dict(
+        asdict=asdict,
+        replace=replace,
+        json=json,
+        uuid=SimpleNamespace(uuid4=lambda: SimpleNamespace(hex="fixed-attempt")),
+        Path=FakePath,
+        StoragePath=FakePath,
+        AttemptLogHandler=Handler,
+        logging=SimpleNamespace(getLogger=lambda name: logger),
+        JsonLoggerConfig=lambda **kwargs: kwargs,
+        jax=SimpleNamespace(local_devices=lambda: [SimpleNamespace(memory_stats=memory)]),
+        run_levanter_train_lm=train,
+        install_coordinated_iris_finalizer=install,
+    )
+    names = {"run_training", "run_training_with_coordinated_finalization", "_run_training"}
+    nodes = [
+        node for node in ast.parse(SOURCE.read_text()).body if isinstance(node, ast.FunctionDef) and node.name in names
+    ]
+    assert len(nodes) == 3
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), str(SOURCE), "exec"), ns)
+    return ns, events, writes, installed, Config(TrainConfig(Trainer(Tracker())))
+
+
+class Checks(unittest.TestCase):
+    def test_receipt_after_last_jax_use(self):
+        ns, events, writes, installed, cfg = load()
+        ns["run_training_with_coordinated_finalization"](cfg, health_timeout_ms=1234)
+        self.assertEqual(events, ["train", "memory", "handler_remove", "handler_close", "install"])
+        self.assertEqual(installed[0][1]["health_timeout_ms"], 1234)
+        receipts = [json.loads(v) for k, v in writes.items() if k.endswith("/finalization.json")]
+        self.assertEqual(len(receipts), 2)
+        self.assertEqual(receipts[0]["tracker_report"]["state"], "complete")
+
+    def test_legacy_does_not_install_candidate(self):
+        ns, _events, writes, installed, cfg = load()
+        ns["run_training"](cfg)
+        self.assertEqual(installed, [])
+        self.assertFalse(any(k.endswith("finalization.json") for k in writes))
+
+    def test_original_application_error_preserved(self):
+        error = ValueError("original")
+        ns, _events, _writes, installed, cfg = load(app_error=error)
+        with self.assertRaises(ValueError) as caught:
+            ns["run_training_with_coordinated_finalization"](cfg, health_timeout_ms=1234)
+        self.assertIs(caught.exception, error)
+        self.assertIs(installed[0][1]["application_error"], error)
+        self.assertIsNone(installed[0][0])
+
+    def test_failed_initialization_does_not_query_jax_devices(self):
+        error = RuntimeError("ONLINE tracker initialization failed")
+        ns, events, writes, _installed, cfg = load(app_error=error, memory_error=AssertionError("must not touch JAX"))
+        with self.assertRaises(RuntimeError) as caught:
+            ns["run_training_with_coordinated_finalization"](cfg, health_timeout_ms=1234)
+        self.assertIs(caught.exception, error)
+        self.assertNotIn("memory", events)
+        self.assertIn("handler_close", events)
+        self.assertTrue(all(json.loads(value) is None for key, value in writes.items() if key.endswith("/memory.json")))
+
+    def test_cleanup_error_does_not_mask_application_error(self):
+        error = SystemExit(7)
+        ns, _events, _writes, installed, cfg = load(app_error=error, handler_error=RuntimeError("cleanup"))
+        with self.assertRaises(SystemExit) as caught:
+            ns["run_training_with_coordinated_finalization"](cfg, health_timeout_ms=1234)
+        self.assertIs(caught.exception, error)
+        self.assertIs(installed[0][1]["application_error"], error)
+
+    def test_cleanup_error_is_failure(self):
+        error = RuntimeError("cleanup")
+        ns, _events, _writes, installed, cfg = load(memory_error=error)
+        with self.assertRaises(RuntimeError) as caught:
+            ns["run_training_with_coordinated_finalization"](cfg, health_timeout_ms=1234)
+        self.assertIs(caught.exception, error)
+        self.assertIs(installed[0][1]["application_error"], error)
+
+    def test_install_failure_preserves_prior_error(self):
+        error = ValueError("original")
+        ns, _events, _writes, _installed, cfg = load(app_error=error, install_error=RuntimeError("install"))
+        with self.assertRaises(ValueError) as caught:
+            ns["run_training_with_coordinated_finalization"](cfg, health_timeout_ms=1234)
+        self.assertIs(caught.exception, error)
+
+    def test_install_failure_without_prior_error_propagates(self):
+        error = RuntimeError("install")
+        ns, _events, _writes, _installed, cfg = load(install_error=error)
+        with self.assertRaises(RuntimeError) as caught:
+            ns["run_training_with_coordinated_finalization"](cfg, health_timeout_ms=1234)
+        self.assertIs(caught.exception, error)
+
+    def test_invalid_health_budget_rejected_before_training(self):
+        for budget in [0, -1, True, 1.5, None]:
+            ns, events, _writes, _installed, cfg = load()
+            with self.assertRaises(ValueError):
+                ns["run_training_with_coordinated_finalization"](cfg, health_timeout_ms=budget)
+            self.assertEqual(events, [])
+
+
+if __name__ == "__main__":
+    result = unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Checks))
+    (Path(os.environ["EMA_GRAM_CHECK_RESULT_DIR"]) / "entrypoint-integration-checks.json").write_text(
+        json.dumps(
+            {
+                "passed": result.wasSuccessful(),
+                "tests": result.testsRun,
+                "scope": (
+                    "actual candidate three wrapper function ASTs and receipt dataclass; "
+                    "fake training, JAX, storage and installer boundaries"
+                ),
+                "runtime_qualified": False,
+                "new_jobs": 0,
+                "remote_calls": 0,
+                "limitations": [
+                    "No real package initialization or numerical kernels",
+                    "No real service, controller or multi-host cleanup qualification",
+                    "Failure before wrapper try/finally and abnormal process termination remain outside these checks",
+                ],
+            },
+            indent=2,
+        )
+        + "\n"
+    )
+    raise SystemExit(0 if result.wasSuccessful() else 1)
