"""Prepare the full Stage A request; one fenced logical submission requires root release."""

import argparse
import hashlib
import json
import os
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

from google.protobuf.json_format import MessageToDict
from iris.cli.connect import open_iris_client
from iris.cli.job import build_resources
from iris.cluster.constraints import region_constraint, zone_constraint
from iris.cluster.types import Entrypoint, EnvironmentSpec
from iris.rpc import job_pb2
from rigging.secrets import SecretBehavior
from rigging.timing import Duration

ROOT = Path("/private/tmp/marin-native-jax-oproj-full-cpu-backend")
PREP = Path("/private/tmp/native-jax-oproj-full-cpu-backend-job-preparation")
COMMAND = PREP / "command.json"
COMMAND_SHA256 = "ff042957283cfcaa169f222cf3975f230ae78be795dd2bcabc1e0283f3bb6cb5"
RELEASE = PREP / "root-dispatch-release.json"
CLAIM = PREP / "submission-claim.json"
STATE = PREP / "submission-state.json"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def prepared_request():
    if Path.cwd().resolve() != ROOT or sha(COMMAND) != COMMAND_SHA256:
        raise ValueError("Exact prepared worktree and immutable command required")
    command = json.loads(COMMAND.read_text())
    for name, expected in command["source_sha256"].items():
        if sha(ROOT / name) != expected:
            raise ValueError(f"Frozen candidate source changed: {name}")
    for name in ("bootstrap", "config", "supervisor"):
        if sha(Path(command[name])) != command[name + "_sha256"]:
            raise ValueError(f"Frozen {name} changed")
    if hashlib.sha256(command["entrypoint_argv"][-1].encode()).hexdigest() != command["launcher_sha256"]:
        raise ValueError("Packed launcher changed")
    resources = build_resources(tpu="v5p-8", gpu=None, cpu=32, memory="256GB", disk="64GB")
    environment = EnvironmentSpec(
        env_vars=command["environment"],
        extras=["tpu"],
        sync_packages=["marin-levanter"],
        secrets={},
        secret_behavior=SecretBehavior.ISOLATE,
    )
    kwargs = dict(
        name=command["job_name"],
        user="dlwh",
        entrypoint=Entrypoint.from_command(*command["entrypoint_argv"]),
        resources=resources,
        environment=environment,
        constraints=[region_constraint(["us-central1"]), zone_constraint("us-central1-a")],
        replicas=1,
        scheduling_timeout=Duration.from_seconds(120),
        timeout=Duration.from_seconds(1020),
        max_retries_failure=0,
        max_retries_preemption=0,
        max_task_failures=0,
        existing_job_policy=job_pb2.EXISTING_JOB_POLICY_ERROR,
        submit_argv=[sys.executable, str(Path(__file__).resolve()), "--submit"],
    )
    validation = {
        "command_sha256": COMMAND_SHA256,
        "wrapper_sha256": sha(Path(__file__)),
        "config_sha256": command["config_sha256"],
        "bootstrap_sha256": command["bootstrap_sha256"],
        "job_id": "/dlwh/" + command["job_name"],
        "candidate_parent_source": command["parent_source_commit"],
        "frozen_source_commit": command["candidate_source_commit"],
        "source_commit_at_preparation": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
        "source_clean_at_preparation": not subprocess.check_output(["git", "status", "--porcelain"], text=True).strip(),
        "resources": MessageToDict(resources.to_proto()),
        "environment": command["environment"],
        "secret_entries": 0,
        "secret_behavior": "ISOLATE",
        "existing_job_policy": "ERROR",
        "external_worker_timeout_seconds": 900,
        "execution_timeout_seconds": 1020,
        "scheduling_timeout_seconds": 120,
        "max_retries_failure": 0,
        "max_retries_preemption": 0,
        "max_task_failures": 0,
    }
    return kwargs, validation


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--validate-only", action="store_true")
    mode.add_argument("--submit", action="store_true")
    args = parser.parse_args()
    kwargs, validation = prepared_request()
    if args.validate_only:
        (PREP / "submit-validation.json").write_text(json.dumps(validation, indent=2) + "\n")
        print(json.dumps(validation))
        return
    release = json.loads(RELEASE.read_text())
    for key in ("command_sha256", "wrapper_sha256", "config_sha256", "bootstrap_sha256", "job_id"):
        if release[key] != validation[key]:
            raise ValueError(f"Root release differs: {key}")
    for key in (
        "scientific_review_passed",
        "transport_IO_review_passed",
        "public_source_and_archive_verified",
        "dispatch_authorized",
    ):
        if release[key] is not True:
            raise ValueError(f"Missing root release: {key}")
    source = release["source_commit"]
    if source != validation["frozen_source_commit"]:
        raise ValueError("Root release must use the exact frozen research commit")
    if len(source) != 40 or source == validation["candidate_parent_source"]:
        raise ValueError("New immutable research source required")
    if source != validation["source_commit_at_preparation"] or not validation["source_clean_at_preparation"]:
        raise ValueError("Exact released source must be clean")
    subprocess.run(["git", "merge-base", "--is-ancestor", validation["candidate_parent_source"], source], check=True)
    changed = subprocess.check_output(
        ["git", "diff", "--name-only", validation["candidate_parent_source"], source], text=True
    )
    if set(changed.splitlines()) != {"research/oproj/child.py", "research/oproj/full_stage_a.md"}:
        raise ValueError("Released source differs from the reviewed two-file candidate")
    proof_path = PREP / "request-validation.json"
    proof = json.loads(proof_path.read_text())
    if release["request_validation_sha256"] != sha(proof_path):
        raise ValueError("Release must bind exact post-publication SDK capture")
    if proof["source_commit_at_capture"] != source or not proof["source_clean_at_capture"]:
        raise ValueError("Actual SDK request must be recaptured after public source freeze")
    if len(release["archive_commit"]) != 40 or os.environ.get("IRIS_JOB_ID") or os.environ.get("IRIS_TASK_ID"):
        raise ValueError("Exact public archive and root workstation required")
    state = validation | {
        "status": "CLAIMED_BEFORE_RPC",
        "claimed_utc": datetime.now(UTC).isoformat(),
        "source_commit": source,
        "archive_commit": release["archive_commit"],
        "automatic_recovery_authorized": False,
    }
    with CLAIM.open("x") as handle:
        handle.write(json.dumps(state, indent=2) + "\n")
    STATE.write_text(json.dumps(state, indent=2) + "\n")
    try:
        with open_iris_client(config_file=ROOT / "lib/iris/config/marin.yaml", workspace=ROOT) as client:
            job = client.submit(**kwargs)
            if str(job.job_id) != state["job_id"]:
                raise ValueError("Returned identity differs; inspect without recovery")
    except Exception as error:
        state.update(status="SUBMISSION_OUTCOME_REQUIRES_INSPECTION", error_type=type(error).__name__)
        STATE.write_text(json.dumps(state, indent=2) + "\n")
        raise
    state.update(status="SUBMITTED", submitted_utc=datetime.now(UTC).isoformat())
    STATE.write_text(json.dumps(state, indent=2) + "\n")
    print(json.dumps({"job_id": state["job_id"], "submitted_utc": state["submitted_utc"]}))


if __name__ == "__main__":
    main()
