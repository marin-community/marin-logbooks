n        },\n        "model.layers.9.self_attn.k_proj.weight": {\n          "allclose": true,\n          "max_abs": 0.0,\n          "mean_abs": 0.0,\n          "relative_l2": 0.0\n        },\n        "model.layers.9.self_attn.o_proj.weight": {\n          "allclose": true,\n          "max_abs": 9.5367431640625e-07,\n          "mean_abs": 9.912515253063248e-12,\n          "relative_l2": 3.15973702527117e-05\n        },\n        "model.layers.9.self_attn.q_proj.weight": {\n          "allclose": true,\n          "max_abs": 1.1920928955078125e-07,\n          "mean_abs": 1.2635448243258907e-12,\n          "relative_l2": 3.249035216867924e-05\n        },\n        "model.layers.9.self_attn.v_proj.weight": {\n          "allclose": true,\n          "max_abs": 0.0,\n          "mean_abs": 0.0,\n          "relative_l2": 0.0\n        },\n        "model.norm.weight": {\n          "allclose": true,\n          "max_abs": 0.0,\n          "mean_abs": 0.0,\n          "relative_l2": 0.0\n        }\n      }\n    },\n    "loss_parity": {\n      "allclose": true,\n      "max_abs": 0.0,\n      "tensors": {\n        "loss": {\n          "allclose": true,\n          "max_abs": 0.0,\n          "mean_abs": 0.0,\n          "relative_l2": 0.0\n        }\n      }\n    },\n    "raw_historical_tensor_bytes_available": false,\n    "note": "Historical report has metrics, not raw gradient hashes. New untouched diagnostic establishes the per-branch raw byte anchor."\n  },\n  "research_source_sha256": {\n    "research/oproj/capture.py": "85252b55a75154829131a80aa6eef20a68be9d022f73f5de6c9ba7cf31f4c552",\n    "research/oproj/child.py": "046e98ae5413f19b3e750fbde1a96b638f65732a18e840bd04df38e8ea61e242",\n    "research/oproj/diagnostic.py": "be8c16d96682e508dc78d200c1015b7b245299e90b0b1eccbda2ddc18ce34a73",\n    "research/oproj/host_runner.py": "1b6e5f9f26706375993444c7b95114cc33aa204f271d22e0abbe6419adc81b77",\n    "research/oproj/callback_compatibility.py": "a46b4f2fae202290daf8fa23571da43c6c2d3c540e97a33bc2d3bcc161a9792f",\n    "research/oproj/abstract.py": "89edf4865985534378889b3e984660d61dd33f51626ba3f2871db394bbc8d4f5",\n    "research/oproj/probes.py": "bc916e7d74c1f3e7aca01a6f640941cc40b36fcfbac0f80ce42260e0aa5ee881",\n    "research/oproj/full_stage_a.md": "5d95f336ca877ab3730b7bd205df2209577126f99ec1c6d84b32981599db9c1b"\n  },\n  "preparation_status": "PRIVATE_FULL_CONTROLLER_CPU_AND_ABSTRACT_VALIDATION_NO_RELEASE",\n  "published_run_source_commit": null,\n  "parent_research_source": "0be2ab8574125f932b18ab8ec5d04a564b432be5",\n  "legacy_host_runner_not_authorized": true,\n  "target_scientific_environment_delta": {\n    "JAX_PLATFORMS": {\n      "old": "tpu",\n      "new": "tpu,cpu"\n    },\n    "only_scientific_environment_change": true,\n    "new_untouched_historical_replay_before_instrumentation_required": true\n  }\n}\n'
CONFIG_SHA256 = '85e075747dcea4156c4d73a01ba41aa9d9d604f70415b682e23ad81ff5a0915b'
SUPERVISOR_TEXT = '# Copyright The Marin Authors\n# SPDX-License-Identifier: Apache-2.0\n\n"""Enforce the tiny gate\'s wall deadline outside its scientific Python process."""\n\nimport argparse\nimport json\nimport os\nimport signal\nimport subprocess\nimport time\nfrom pathlib import Path\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument("--timeout", type=float, required=True)\n    parser.add_argument("--receipt", type=Path, required=True)\n    parser.add_argument("command", nargs=argparse.REMAINDER)\n    args = parser.parse_args()\n    command = args.command[1:] if args.command[:1] == ["--"] else args.command\n    if not command or args.timeout <= 0 or args.timeout > 900:\n        raise ValueError("A worker command and positive deadline no greater than 900 seconds are required")\n    receipt = {"command": command, "timeout_seconds": args.timeout, "timed_out": False, "completed": False}\n    started = time.monotonic()\n    with subprocess.Popen(command, start_new_session=True) as process:\n        receipt["owned_process_group"] = process.pid\n        try:\n            remaining = max(0, args.timeout - (time.monotonic() - started))\n            process.wait(timeout=remaining)\n            receipt["completed"] = process.returncode == 0\n        except subprocess.TimeoutExpired:\n            receipt["timed_out"] = True\n            os.killpg(process.pid, signal.SIGKILL)\n            process.wait()\n        finally:\n            if process.poll() is None:\n                os.killpg(process.pid, signal.SIGKILL)\n                process.wait()\n            receipt["worker_returncode"] = process.returncode\n            receipt["elapsed_seconds"] = time.monotonic() - started\n            args.receipt.write_text(json.dumps(receipt, indent=2) + "\\n")\n    raise SystemExit(124 if receipt["timed_out"] else process.returncode)\n\n\nif __name__ == "__main__":\n    main()\n'
SUPERVISOR_SHA256 = '6d3fef98bd91533ad385e12479b733834ac9175f786c3e510c6cf53afa812132'
PARENT_SOURCE = "0be2ab8574125f932b18ab8ec5d04a564b432be5"
RESEARCH_SOURCE = 'bef5c25fd34145fa4ec089594daee4e3c8bf1113'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    root = Path.cwd()
    if "jax" in sys.modules:
        raise ValueError("Bootstrap must not initialize JAX")
    if hashlib.sha256(CONFIG_TEXT.encode()).hexdigest() != CONFIG_SHA256:
        raise ValueError("Frozen configuration bytes changed")
    if hashlib.sha256(SUPERVISOR_TEXT.encode()).hexdigest() != SUPERVISOR_SHA256:
        raise ValueError("Frozen supervisor bytes changed")
    config = json.loads(CONFIG_TEXT)
    for name, expected in {**config["source_file_sha256"], **config["research_source_sha256"]}.items():
        if sha(root / name) != expected:
            raise ValueError(f"Frozen worker source changed: {name}")
    if any(os.environ.get(k) != v for k, v in config["scientific_environment"].items()):
        raise ValueError("Exact tpu,cpu scientific environment required before child initialization")
    output = Path(os.environ["IRIS_OUTPUT_DIR"])
    output.mkdir(parents=True, exist_ok=True)
    if any(output.iterdir()):
        raise FileExistsError("Fresh empty Iris output directory required")
    spec = importlib.util.spec_from_file_location("stage_a_retention", root / "research/oproj/diagnostic.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    retention = module.retention

    with tempfile.TemporaryDirectory(prefix="oproj-full-stage-a-") as temporary:
        workspace = Path(temporary)
        stage = workspace / "diagnostics"
        stage.mkdir()
        config_path = workspace / "config.json"
        config_path.write_text(CONFIG_TEXT)
        supervisor = workspace / "supervisor.py"
        supervisor.write_text(SUPERVISOR_TEXT)
        argv = [
            sys.executable,
            str(supervisor),
            "--timeout",
            "900",
            "--receipt",
            str(stage / "supervisor.json"),
            "--",
            sys.executable,
            "research/oproj/diagnostic.py",
            "run",
            "--mode",
            "target",
            "--config",
            str(config_path),
            "--output",
            str(stage / "stage-a"),
        ]
        (stage / "worker-provenance.json").write_text(
            json.dumps(
                {
                    "scientific_source": config["source_commit"],
                    "research_source_parent": PARENT_SOURCE,
                    "research_source_commit_declared": RESEARCH_SOURCE,
                    "source_commit_not_checked_in_worker": True,
                    "config_sha256": CONFIG_SHA256,
                    "supervisor_sha256": SUPERVISOR_SHA256,
                    "research_source_sha256": config["research_source_sha256"],
                    "argv": argv,
                    "parent_jax_imported": "jax" in sys.modules,
                    "retention": "One regional Iris attempt archive; no direct backup or raw arrays",
                },
                indent=2,
            )
            + "\n"
        )
        result = subprocess.run(argv, check=False)
        try:
            if any(p.is_symlink() or (not p.is_file() and not p.is_dir()) for p in stage.rglob("*")):
                raise ValueError("Symlink or special file in diagnostic staging")
            receipt = retention(stage)
            (stage / "bootstrap-retention.json").write_text(json.dumps(receipt, indent=2) + "\n")
            retention(stage)
            if result.returncode == 0:
                report = json.loads((stage / "stage-a/report.json").read_text())
                bound = json.loads((stage / "supervisor.json").read_text())
                if not report["completed"] or not report["identity"]["instrumentation_loss_all_raw_gradients_exact"]:
                    raise ValueError("Successful worker lacks complete Stage A identity")
                if not bound["completed"] or bound["timed_out"] or bound["worker_returncode"] != 0:
                    raise ValueError("Successful worker lacks successful external supervisor")
            shutil.copytree(stage, output / "diagnostics")
        except Exception as error:
            (output / "bootstrap-failure.json").write_text(
                json.dumps(
                    {
                        "completed": False,
                        "worker_returncode": result.returncode,
                        "error_type": type(error).__name__,
                        "error": str(error)[:2048],
                        "staging_not_copied": not (output / "diagnostics").exists(),
                        "no_direct_storage": True,
                    },
                    indent=2,
                )
                + "\n"
            )
            raise
        raise SystemExit(result.returncode)


if __name__ == "__main__":
    main()
