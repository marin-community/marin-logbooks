"""Execute a frozen public RoPE/Splash regression on sequential source variants."""
import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import tempfile
import zlib

PAYLOAD_B64 = ''
MAX_EXEC_BYTES = 96 * 1024
MAX_FILES = 24
MAX_FILE_BYTES = 1024 * 1024
MAX_BYTES = 16 * 1024 * 1024

CHILD = '''import hashlib,importlib,importlib.util,json,pathlib,sys
request=json.loads(sys.argv[1])
root=pathlib.Path(request["worktree"]).resolve()
asset=pathlib.Path(request["prototype"])
actual={name:hashlib.sha256((root/name).read_bytes()).hexdigest() for name in request["source_file_sha256"]}
if actual!=request["source_file_sha256"]:raise ValueError("Child source byte mismatch")
if hashlib.sha256(asset.read_bytes()).hexdigest()!=request["prototype_sha256"]:raise ValueError("Prototype byte mismatch")
spec=importlib.util.spec_from_file_location("frozen_splash_rotary_regression",asset)
module=importlib.util.module_from_spec(spec)
sys.modules[spec.name]=module
spec.loader.exec_module(module)
core=importlib.import_module("levanter.grug.attention._core")
levanter=importlib.import_module("levanter")
haliax=importlib.import_module("haliax")
rotary=importlib.import_module("levanter.layers.rotary")
rotary_native=importlib.import_module("levanter.layers.rotary_native")
modules={name:str(pathlib.Path(m.__file__).resolve()) for name,m in [("core",core),("levanter",levanter),("haliax",haliax),("rotary",rotary),("rotary_native",rotary_native)]}
expected={"core":root/"lib/levanter/src/levanter/grug/attention/_core.py","levanter":root/"lib/levanter/src/levanter/__init__.py","haliax":root/"lib/haliax/src/haliax/__init__.py","rotary":root/"lib/levanter/src/levanter/layers/rotary.py","rotary_native":root/"lib/levanter/src/levanter/layers/rotary_native.py"}
if any(pathlib.Path(modules[k])!=expected[k] for k in modules):raise ValueError("Imported wrong source module")
barrier="optimization_barrier" in core._tpu_splash_attention.__code__.co_names
if barrier!=request["candidate"]:raise ValueError("Actual imported core code does not match variant")
if module.jax.default_backend()!=request["backend"] or module.jax.device_count()!=4 or module.jax.local_device_count()!=4 or module.jax.process_count()!=1:raise ValueError("Unexpected process/device topology")
if request["backend"]=="tpu" and not all("v5" in d.device_kind.lower() and "lite" not in d.device_kind.lower() for d in module.jax.devices()):raise ValueError("Expected TPUv5p")
if (module.BATCH,module.SEQUENCE,module.QUERY_HEADS,module.KV_HEADS,module.ATOL,module.RTOL)!=(4,512,16,4,1e-5,1e-4):raise ValueError("Immutable prototype configuration differs")
# Reconstruct the frozen seed173 host generation for provenance only; no runtime interception or altered operands.
reconstructed={}
for dim in [128,64]:
 shapes=[(4,512,16,dim),(4,512,4,dim),(4,512,4,dim),(4,512),(4,512,16,dim)]
 rng=module.np.random.default_rng(173)
 arrays=[rng.standard_normal(shape).astype(module.np.float32) for shape in shapes[:3]]
 arrays.append(module.np.broadcast_to(module.np.arange(512,dtype=module.np.int32),shapes[3]).copy())
 ct=rng.standard_normal(shapes[4]).astype(module.np.float32)
 ct/=module.np.sqrt(module.np.mean(ct.astype(module.np.float64)**2))
 arrays.append(ct)
 records=[]
 for name,array in zip(["query_master","key_master","value_master","positions","cotangent"],arrays,strict=True):
  digest=hashlib.sha256(json.dumps([list(array.shape),str(array.dtype)]).encode())
  digest.update(array.tobytes())
  records.append({"name":name,"shape":list(array.shape),"dtype":str(array.dtype),"sha256":digest.hexdigest()})
 reconstructed[str(dim)]=records
record={"verified":True,"prototype_sha256":request["prototype_sha256"],"source_pin":request["source_pin"],"source_file_sha256":actual,"modules":modules,"actual_function_contains_barrier":barrier,"dont_write_bytecode":sys.dont_write_bytecode,"pycache_prefix":sys.pycache_prefix,"backend":module.jax.default_backend(),"global_device_count":module.jax.device_count(),"local_device_count":module.jax.local_device_count(),"process_count":module.jax.process_count(),"devices":[{"kind":d.device_kind,"id":d.id,"process_index":d.process_index,"description":str(d)} for d in module.jax.devices()],"host_reconstructed_inputs":reconstructed,"input_hash_scope":"Reconstructed independently from immutable seed173 generation; not observed input/device-boundary hashes. Exact prototype source is executed unchanged, without hooks.","abstract_only":request["abstract_only"],"xla_flags":module.os.environ.get("XLA_FLAGS")}
pathlib.Path(request["runtime_path"]).write_text(json.dumps(record,indent=2,sort_keys=True)+"\\n")
sys.argv=[str(asset),"--source-pin",request["source_pin"],"--head64-control","--output-dir",request["output_dir"]]+(["--abstract-only"] if request["abstract_only"] else [])
module.main()
'''


def digest(data):
    return hashlib.sha256(data).hexdigest()


def write_json(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')


def source_guard(worktree, expected):
    actual = {name: digest((worktree / name).read_bytes()) for name in expected}
    if actual != expected:
        raise ValueError('Source bytes differ from the frozen variant')
    return actual


def child_run(label, payload, args):
    expected = payload[label + '_file_sha256']
    worktree = args.worktree.resolve()
    pin = payload['baseline_source' if label == 'baseline' else 'candidate_source']
    runtime_path = args.output_dir / (label + '-runtime.json')
    request = {'worktree': str(worktree), 'prototype': payload['prototype_path'], 'prototype_sha256': payload['prototype_sha256'],
        'source_pin': pin, 'source_file_sha256': expected, 'candidate': label == 'candidate', 'backend': args.expected_backend,
        'output_dir': str(args.output_dir / label), 'runtime_path': str(runtime_path), 'abstract_only': args.abstract_only}
    environment = dict(os.environ, PYTHONDONTWRITEBYTECODE='1',
        PYTHONPYCACHEPREFIX=tempfile.mkdtemp(prefix='native-jax-rotary-ab-' + label + '-'),
        PYTHONPATH=str(worktree / 'lib/levanter/src') + ':' + str(worktree / 'lib/haliax/src'))
    command = [sys.executable, '-c', CHILD, json.dumps(request, separators=(',', ':'))]
    sizes = {'argv_bytes': sum(len(v.encode()) + 1 for v in command),
        'environment_bytes': sum(len((k + '=' + v).encode()) + 1 for k, v in environment.items()),
        'largest_argument_bytes': max(len(v.encode()) for v in command)}
    if sizes['argv_bytes'] + sizes['environment_bytes'] >= MAX_EXEC_BYTES:
        raise ValueError('Child command/environment exceeds96KiB')
    before = source_guard(worktree, expected)
    result = subprocess.run(command, cwd=worktree, env=environment)
    after = source_guard(worktree, expected)
    launch = {'source_pin': pin, 'exit_code': result.returncode, 'source_file_sha256_before': before,
        'source_file_sha256_after': after, 'command': command, 'exec_sizes': sizes,
        'environment': {k: environment[k] for k in ['PYTHONPATH','PYTHONDONTWRITEBYTECODE','PYTHONPYCACHEPREFIX','XLA_FLAGS','JAX_PLATFORMS']},
        'parent_imported_jax': 'jax' in sys.modules}
    write_json(args.output_dir / (label + '-launch.json'), launch)
    return launch


def inspect_results(payload, args, launches):
    reports = {case: json.loads((args.output_dir / case / 'proof.json').read_text()) for case in ('baseline', 'candidate')}
    runtime = {case: json.loads((args.output_dir / (case + '-runtime.json')).read_text()) for case in reports}
    guards = {'same_reconstructed_host_inputs': runtime['baseline']['host_reconstructed_inputs'] == runtime['candidate']['host_reconstructed_inputs'],
        'distinct_fresh_pycache': runtime['baseline']['pycache_prefix'] != runtime['candidate']['pycache_prefix'],
        'same_physical_device_records': runtime['baseline']['devices'] == runtime['candidate']['devices'],
        'same_exact_xla_flags': all(r['xla_flags'] == '--xla_allow_excess_precision=false' for r in runtime.values()),
        'candidate_core_restored': source_guard(args.worktree, payload['candidate_file_sha256']) == payload['candidate_file_sha256']}
    for label, report in reports.items():
        guards[label + '_frozen_prototype'] = report['script_sha256'] == payload['prototype_sha256']
        guards[label + '_source_pin'] = report['source_pin'] == payload['baseline_source' if label == 'baseline' else 'candidate_source']
        guards[label + '_runtime_imports'] = runtime[label]['verified']
        guards[label + '_head128_head64'] = [v['head_dim'] for v in report['cases']] == [128,64]
        guards[label + '_unchanged_criteria'] = report['atol'] == 1e-5 and report['rtol'] == 1e-4
        guards[label + '_expected_exit'] = launches[label]['exit_code'] == (0 if args.abstract_only or all(c['passed'] for c in report['cases']) else 1)
    comparison = None
    if not args.abstract_only:
        comparison = {}
        for left, right in zip(reports['baseline']['cases'], reports['candidate']['cases'], strict=True):
            dim = str(left['head_dim'])
            names = ['loss','forward','query_master_vjp','key_master_vjp','value_master_vjp']
            guards[dim + '_all_named_hashes_unchanged'] = all(left['named'][n]['sha256'] == right['named'][n]['sha256'] for n in names)
            guards[dim + '_native_forward_unchanged'] = all(left['native'][n]['sha256'] == right['native'][n]['sha256'] for n in ['loss','forward'])
            guards[dim + '_matching_result_layouts'] = all(left[v][n]['shape'] == right[v][n]['shape'] and left[v][n]['dtype'] == right[v][n]['dtype'] and left[v][n]['partition_spec'] == right[v][n]['partition_spec'] for n in names for v in ['named','native'])
            guards[dim + '_canonical_named_native_result_layouts'] = all(record['named'][n]['shape'] == record['native'][n]['shape'] and record['named'][n]['dtype'] == record['native'][n]['dtype'] and record['named'][n]['partition_spec'] == record['native'][n]['partition_spec'] for record in [left,right] for n in names)
            comparison[dim] = {'baseline_passed': left['passed'], 'candidate_passed': right['passed'],
                'before': left['comparisons'], 'after': right['comparisons'],
                'new_failed_outputs': [n for n in names if left['comparisons'][n]['allclose'] and not right['comparisons'][n]['allclose']],
                'removed_failed_outputs': [n for n in names if not left['comparisons'][n]['allclose'] and right['comparisons'][n]['allclose']]}
    passed = all(guards.values())
    reproduced = None if args.abstract_only else (not comparison['128']['baseline_passed'] and comparison['128']['candidate_passed'] and comparison['64']['baseline_passed'] and comparison['64']['candidate_passed'])
    return {'passed_controls': passed, 'guards': guards, 'comparisons': comparison, 'compact_regression_reproduced': reproduced,
        'numeric_result_policy': 'Record frozen seed/criteria outcomes without tuning or retries. Baseline numerical failure is expected only if observed; no compact regression claim unless head128 baselineFAIL/candidatePASS and head64 bothPASS.',
        'source_pins': {'baseline': payload['baseline_source'], 'candidate': payload['candidate_source']},
        'prototype_sha256': payload['prototype_sha256'], 'source_file_sha256': {'baseline':payload['baseline_file_sha256'],'candidate':payload['candidate_file_sha256']},
        'controller_sha256': digest(Path(__file__).read_bytes()), 'parent_imported_jax': 'jax' in sys.modules,
        'abstract_only': args.abstract_only, 'full_trainer_identity_tested': False,
        'limitations': ['No HLO or tensor/weight artifacts. Prior large fragment A/B retains the optimized rounding dataflow evidence.',
            'Host input hashes are reconstructed from immutable generation, not intercepted/observed device operands.',
            'Compact unit-RMS cotangent tests per-unit derivatives, not full model mean-CE normalization, training trajectory, performance or convergence.']}


def archive_outputs(output):
    files = sorted(p for p in output.rglob('*') if p.is_file())
    if any(p.is_symlink() for p in output.rglob('*')):
        raise ValueError('No output symlinks allowed')
    if any(p.suffix != '.json' or p.stat().st_size > MAX_FILE_BYTES for p in files):
        raise ValueError('Unexpected artifact or per-file cap exceeded')
    total = sum(p.stat().st_size for p in files)
    if len(files) > MAX_FILES or total > MAX_BYTES:
        raise ValueError('Output hard cap exceeded; no truncation')
    archive = output.parent / (output.name + '-diagnostics.tar.gz')
    with tarfile.open(archive, 'w:gz') as stream:
        for p in files:
            stream.add(p, arcname=str(p.relative_to(output)), recursive=False)
    if archive.stat().st_size > MAX_BYTES:
        raise ValueError('Compressed output cap exceeded')
    return archive, {'entries': len(files), 'raw_bytes': total, 'compressed_bytes': archive.stat().st_size,
        'sha256': digest(archive.read_bytes()), 'files': [{'path':str(p.relative_to(output)),'bytes':p.stat().st_size,'sha256':digest(p.read_bytes())} for p in files]}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--worktree', type=Path, required=True)
    parser.add_argument('--output-dir', type=Path, required=True)
    parser.add_argument('--expected-backend', choices=['cpu','tpu'], required=True)
    parser.add_argument('--abstract-only', action='store_true')
    parser.add_argument('--backup-uri', required=True)
    args = parser.parse_args()
    args.worktree, args.output_dir = args.worktree.resolve(), args.output_dir.resolve()
    if 'jax' in sys.modules:
        raise RuntimeError('Controller parent must not import JAX')
    if os.environ.get('XLA_FLAGS') != '--xla_allow_excess_precision=false':
        raise ValueError('Exact XLA precision flags required')
    payload = json.loads(zlib.decompress(base64.b64decode(PAYLOAD_B64)))
    asset = Path(payload['prototype_path']); data = payload['prototype'].encode()
    if digest(data) != payload['prototype_sha256']:
        raise ValueError('Prototype bytes differ')
    if asset.exists() and asset.read_bytes() != data:
        raise FileExistsError('Existing prototype differs')
    if not asset.exists(): asset.write_bytes(data)
    args.output_dir.mkdir(parents=True, exist_ok=True)
    if any(args.output_dir.iterdir()):
        raise FileExistsError("Use a fresh empty diagnostic output directory")
    core = args.worktree / payload['core_path']
    original = payload['baseline_core'].encode(); candidate = payload['candidate_core'].encode()
    source_guard(args.worktree, payload['candidate_file_sha256'])
    launches = {}
    try:
        core.write_bytes(original)
        launches['baseline'] = child_run('baseline',payload,args)
    finally:
        core.write_bytes(candidate)
    launches['candidate'] = child_run('candidate',payload,args)
    summary = inspect_results(payload,args,launches)
    summary['launch_exit_codes'] = {k:v['exit_code'] for k,v in launches.items()}
    write_json(args.output_dir/'ab-summary.json',summary)
    archive, report = archive_outputs(args.output_dir)
    print('ROTARY_REGRESSION_BACKUP ' + json.dumps(report | {'archive':str(archive),'uri':args.backup_uri,'passed_controls':summary['passed_controls'],'compact_regression_reproduced':summary['compact_regression_reproduced']},sort_keys=True),flush=True)
    backup = subprocess.run([sys.executable,'-m','rigging.fsutil.cli','cp','-n',str(archive),args.backup_uri])
    print('ROTARY_REGRESSION_BACKUP_RESULT ' + json.dumps({'exit_code':backup.returncode,'uri':args.backup_uri}),flush=True)
    if backup.returncode or not summary['passed_controls']:
        raise SystemExit(1)
    if not args.abstract_only and not all(v['candidate_passed'] for v in summary['comparisons'].values()):
        raise SystemExit(1)


if __name__ == '__main__':
    main()
