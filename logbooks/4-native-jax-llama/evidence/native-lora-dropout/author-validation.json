  "implemented": [
    "Optional keys through LinearProjection/Linear, raw blocks, QKV/output projections, MLP, existing ArrayStacked.fold key in_axes.",
    "Named nested key schedule, single-layer unsplit edge, second LoRA subkey, distinct canonical activations/loss versus direct-logit root schedules.",
    "Nonzero array LoRA dropout, explicit no-key training error, keyless inference, p=1 all-drop behavior, dtype-preserving scaling.",
    "Logical mask geometry preserves named dense o-projection head-major order and ordinary reversed named input-axis order.",
    "Unbatched data replication shares original logical example mask; gather precedes removing batch dimension for valid explicit-sharding gradients.",
    "Paged prefill/continuation routes layer/projection keys and uses named position-major output mask order.",
    "Named paged decode uses existing layers.get_layer to preserve shared dropout inference state rather than blindly indexing bool leaves.",
    "Nearest native adapter docs updated and canonical nonzero train_lm checkpoint-continuation fixture retained with nonzero A/B."
  ],
  "design_rationale": {
    "dropout_layout": "One immutable shape/permutation value at the existing projection boundary; no tensor registry or adapter target-name geometry hacks.",
    "array_dropout": "Existing hnn.Dropout imports Haliax; stock eqx.nn.Dropout cannot express logical mask replication/axis ordering or identical named p=1 behavior. A small pure-JAX Equinox module provides only this required extension.",
    "scan_and_trainer": "Existing ArrayStacked fold/in_axes, Trainer RNG/microbatching, inference_mode, and checkpoint infrastructure reused; no duplicated stack or trainer.",
    "separate_dpo_work": "No train_dpo edits. Native output-head adaptation and the separately owned DPO composition remain outside this patch."
  },
