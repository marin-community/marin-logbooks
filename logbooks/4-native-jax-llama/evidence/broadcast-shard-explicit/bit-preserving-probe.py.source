import json
from pathlib import Path
import jax
import jax.numpy as jnp
import numpy as np
from jax.sharding import AxisType,Mesh,NamedSharding,PartitionSpec as P

n=len(jax.devices());mesh=Mesh(np.asarray(jax.devices()).reshape(2,n//2),('data','model'),axis_types=(AxisType.Explicit,)*2)
f32=np.asarray([0x80000000,0x3f800001,0xbf800001,0x7fc01234],dtype=np.uint32).view(np.float32)
f16=np.asarray([0x8000,0x3c01,0xbc01,0x7e55],dtype=np.uint16).view(np.float16)
bf16=np.asarray([0x8000,0x3f81,0xbf81,0x7fc5],dtype=np.uint16).view(jnp.bfloat16)
cases={'scalar':np.asarray(-0.,dtype=np.float32),'float16':f16,'bfloat16':bf16,'float32':f32,'complex64':f32.view(np.complex64),'bool':np.asarray([True,False]),'int8':np.asarray([-1,127],dtype=np.int8),'uint8':np.asarray([255,123],dtype=np.uint8),'int16':np.asarray([-1,32767],dtype=np.int16),'uint16':np.asarray([65535,123],dtype=np.uint16),'int32':np.asarray([-1,2147483647],dtype=np.int32),'uint32':np.asarray([4294967295,123],dtype=np.uint32)}
if jax.config.x64_enabled:
 f64=np.asarray([0x8000000000000000,0x3ff0000000000001,0xbff0000000000001,0x7ff8000000001234],dtype=np.uint64).view(np.float64)
 cases.update(float64=f64,complex128=f64.view(np.complex128),int64=np.asarray([-1,9223372036854775807],dtype=np.int64),uint64=np.asarray([18446744073709551615,123],dtype=np.uint64))
real=(np.arange(512*512,dtype=np.float32).reshape(512,512)/(512*512)).astype(np.float32);real[0,0]=-0.
cases.update(matrix=real,complex_matrix=np.asarray(real,dtype=np.complex64))
results=[]
for name,value in cases.items():
 for source in [0,1]:
  staging=NamedSharding(mesh,P(mesh.axis_names));target=NamedSharding(mesh,P() if value.ndim==0 else P('data','model') if value.ndim==2 else P('data'))
  x=jax.make_array_from_callback((n,*value.shape),staging,lambda idx:np.expand_dims(value if idx[0].start==source else np.zeros_like(value),0))
  def fn(x):
   def select_source(value):
    floating=jnp.issubdtype(value.dtype,jnp.floating)
    bits=jax.lax.bitcast_convert_type(value,jnp.uint8) if floating else value
    bits=bits.at[jnp.asarray([source])].get(out_sharding=NamedSharding(mesh,P()))[0]
    return jax.lax.bitcast_convert_type(bits,value.dtype) if floating else bits
   if jnp.issubdtype(x.dtype,jnp.complexfloating):
    x=jax.lax.complex(select_source(jax.lax.real(x)),select_source(jax.lax.imag(x)))
   else:x=select_source(x)
   return jax.sharding.reshard(x,target)
  with jax.set_mesh(mesh):
   compiled=jax.jit(fn).lower(x).compile();actual=compiled(x)
  assert np.asarray(actual).tobytes()==value.tobytes(),(name,source,np.asarray(actual),value)
  assert actual.sharding.is_equivalent_to(target,value.ndim)
  for shard in actual.addressable_shards:assert np.asarray(shard.data).tobytes()==value[shard.index].tobytes()
  r={'case':name,'source_index':source,'dtype':str(value.dtype),'shape':list(value.shape),'bits_equal':True,'physical_layout':str(actual.sharding.spec)}
  if name in ['matrix','complex_matrix'] and source==1:
   mem=compiled.memory_analysis();hlo=compiled.as_text();p=Path(f'output/native-jax-broadcast-bit-preserving-{n}-x64{int(jax.config.x64_enabled)}-{name}.hlo');p.write_text(hlo)
   r['memory']={k:getattr(mem,k) for k in ['argument_size_in_bytes','output_size_in_bytes','temp_size_in_bytes']};r['collectives']=[line.strip() for line in hlo.splitlines() if 'all-reduce(' in line or 'all-gather(' in line];r['hlo']=str(p)
  results.append(r)
p=Path(f'output/native-jax-broadcast-bit-preserving-{n}-x64{int(jax.config.x64_enabled)}.json');p.write_text(json.dumps({'devices':n,'jax':jax.__version__,'x64':jax.config.x64_enabled,'cases':results},indent=2)+'\n');print(p.read_text())
