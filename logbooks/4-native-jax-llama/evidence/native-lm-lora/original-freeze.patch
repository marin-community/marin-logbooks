+def test_array_lora_matches_independent_values_gradients_and_placements(row):
+    model_size = 2 if jax.device_count() >= 4 else 1
+    mesh = Mesh(
+        np.array(jax.devices()).reshape(-1, model_size), ("data", "model"), axis_types=(AxisType.Explicit,) * 2
