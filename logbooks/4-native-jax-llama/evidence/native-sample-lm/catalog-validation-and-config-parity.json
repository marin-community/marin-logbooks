  "reproduction_script_text": "import dataclasses\nimport hashlib\nimport importlib.util\nimport json\nimport pickle\nimport sys\nfrom pathlib import Path\n\nroot = Path.cwd()\nscript = root / 'lib/levanter/scripts/bench/bench_llama_native.py'\nspec = importlib.util.spec_from_file_location('bench_llama_native_config_proof', script)\nmodule = importlib.util.module_from_spec(spec)\nsys.modules[spec.name] = module\nspec.loader.exec_module(module)\ncases = {\n    'defaults': module.BenchmarkConfig(),\n    'existing_cpu_test': module.BenchmarkConfig(vocab_size=32, hidden_dim=16, intermediate_dim=24, num_layers=1, num_heads=4, num_kv_heads=2, batch_size=2, seq_len=8, warmup_steps=1, measured_steps=3, profile_steps=2),\n    'nondefault_architecture': module.BenchmarkConfig(vocab_size=64, hidden_dim=32, intermediate_dim=48, num_layers=3, num_heads=8, num_kv_heads=4, seq_len=16, gradient_checkpointing=False),\n}\nactual = {name: {'legacy': module._legacy_config(config), 'native': module._native_config(config)} for name,config in cases.items()}\noutput = Path(sys.argv[2])\nif sys.argv[1] == 'before':\n    with open(output.with_suffix('.pkl'), 'wb') as f: pickle.dump(actual, f)\n    report = {'script': str(script), 'script_sha256': hashlib.sha256(script.read_bytes()).hexdigest(), 'configs': {name: {variant: dataclasses.asdict(config) for variant,config in configs.items()} for name,configs in actual.items()}}\nelse:\n    with open(sys.argv[3], 'rb') as f: before = pickle.load(f)\n    results = {}\n    for name,configs in actual.items():\n        results[name] = {}\n        for variant,config in configs.items():\n            expected = before[name][variant]\n            assert expected == config, (name,variant)\n            fields = {field.name: getattr(expected,field.name) == getattr(config,field.name) for field in dataclasses.fields(config)}\n            assert all(fields.values()), (name,variant,fields)\n            results[name][variant] = {'all_fields_equal': True, 'field_count': len(fields), 'fields': fields, 'layer_norm_epsilon': config.layer_norm_epsilon}\n    report = {'script': str(script), 'script_sha256': hashlib.sha256(script.read_bytes()).hexdigest(), 'results': results}\noutput.write_text(json.dumps(report,indent=2,default=str)+'\\n')\n",
  "reproduction_script_exact_sha256": "cf338d04935994e473a34d7b7fd8d8060afb023695f3a0d9795535800f065a07",
