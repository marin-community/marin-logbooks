ayer. Active operations with zero inputs or\ncotangents retain positive scales, so their histories still update. Ordinary\ngradients and the FP8 quantization algorithm are unchanged.\n\n","source_sha256":{"lib/haliax/src/haliax/quantization.py":"8212a7255391002d91ed6e773931ee1841d973cc8349cc6c41dc6a715f73bcee","lib/haliax/tests/test_fp8.py":"a06a70d9be1b3d6b52298df17c57d86bf64f3f6c85c30edede88cc23374f5271"},"source_unchanged":true,"full_affected_qualification":"running; no passing verdict yet","catalog":"not run yet","published":false}}
