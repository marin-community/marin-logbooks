+@support_torch_compile
+class _CompiledHeroShortConv(nn.Module):
+    def __init__(
+        self, *, vllm_config: VllmConfig, dtype: torch.dtype, prefix: str = ""
+    ) -> None:
+        super().__init__()
+        self.conv = GrugMoeShortConv(
+            dim=2,
+            kernel_size=4,
+            params_dtype=dtype,
+            cache_config=None,
+            prefix=prefix,
+        )
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return self.conv(hidden_states + 1) * 2
+
+
+def _sconv_batch_metadata(
+    *,
+    decode_slots: list[int],
+    prefill_slots: list[int],
+    prefill_lengths: list[int],
+    initial_states: list[bool],
+) -> ShortConvAttentionMetadata:
+    query_start = [0]
+    for length in prefill_lengths:
+        query_start.append(query_start[-1] + length)
+    return ShortConvAttentionMetadata(
+        num_prefills=len(prefill_slots),
+        num_prefill_tokens=query_start[-1],
+        num_decodes=len(decode_slots),
+        num_decode_tokens=len(decode_slots),
+        num_reqs=len(decode_slots) + len(prefill_slots),
+        query_start_loc_p=torch.tensor(query_start, device="cuda", dtype=torch.int32),
+        has_initial_states_p=torch.tensor(initial_states, device="cuda"),
+        state_indices_tensor_p=torch.tensor(
+            prefill_slots, device="cuda", dtype=torch.int32
+        ),
+        state_indices_tensor_d=torch.tensor(
+            decode_slots, device="cuda", dtype=torch.int32
+        ),
+        num_accepted_tokens=None,
+        query_start_loc_d=None,
+        block_idx_last_scheduled_token=None,
+        block_idx_first_scheduled_token_p=None,
+        block_idx_last_computed_token=None,
+        block_idx_last_scheduled_token_prev_step=None,
+        num_computed_tokens_p=None,
+        seq_lens=torch.ones(
+            len(decode_slots) + len(prefill_slots), device="cuda", dtype=torch.int32
+        ),
+    )
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+@pytest.mark.parametrize("use_inductor_graph_partition", [False, True])
+@torch.inference_mode()
+def test_hero_sconv_piecewise_replay_uses_current_requests_and_history(
+    dtype, use_inductor_graph_partition, monkeypatch
+):
+    monkeypatch.setenv("VLLM_DISABLE_COMPILE_CACHE", "1")
+    prefix = "hero.sconv.piecewise"
+    vllm_config = VllmConfig(
+        compilation_config=CompilationConfig(
+            mode=CompilationMode.VLLM_COMPILE,
+            cudagraph_mode=CUDAGraphMode.PIECEWISE,
+            cudagraph_capture_sizes=[4],
+            cudagraph_copy_inputs=True,
+            use_inductor_graph_partition=use_inductor_graph_partition,
+        ),
+    )
+    with set_current_vllm_config(vllm_config):
+        model = _CompiledHeroShortConv(
+            vllm_config=vllm_config, dtype=dtype, prefix=prefix
+        ).eval().cuda()
+    weight = torch.tensor(
+        [[1.0, 0.75], [0.5, -0.25], [-0.25, 0.125], [0.125, 0.5]],
+        device="cuda",
+        dtype=dtype,
+    )
+    model.conv.weight.copy_(weight)
+    model.conv.kv_cache = (
+        torch.zeros(4, *model.conv.get_state_shape()[0], device="cuda", dtype=dtype),
+    )
+    cache = model.conv.kv_cache[0]
+    cache[0].fill_(42)
+    cache[3].fill_(17)
+    inputs = torch.zeros(4, 2, device="cuda", dtype=dtype)
+
+    # Compile with profiling metadata, then capture around a real prefill.
+    # Its unprepared convolution metadata takes a GPU-to-CPU path, so this
+    # also fails if ShortConv accidentally enters a captured partition.
+    with set_forward_context(None, vllm_config, num_tokens=4):
+        model(inputs)
+    captures_before = compilation_counter.num_cudagraph_captured
+    with set_forward_context(
+        {
+            prefix: _sconv_batch_metadata(
+                decode_slots=[],
+                prefill_slots=[1, 2],
+                prefill_lengths=[2, 2],
+                initial_states=[False, False],
+            )
+        },
+        vllm_config,
+        num_tokens=4,
+        cudagraph_runtime_mode=CUDAGraphMode.PIECEWISE,
+        batch_descriptor=BatchDescriptor(num_tokens=4),
+    ):
+        model(inputs)
+    assert compilation_counter.num_cudagraph_captured > captures_before
+    captures_after = compilation_counter.num_cudagraph_captured
+
+    def run_batch(metadata, rows, expected):
+        inputs.fill_(-999)
+        inputs[: rows.shape[0]].copy_(rows - 1)
+        with set_forward_context(
+            {prefix: metadata},
+            vllm_config,
+            num_tokens=4,
+            cudagraph_runtime_mode=CUDAGraphMode.PIECEWISE,
+            batch_descriptor=BatchDescriptor(num_tokens=4),
+        ):
+            output = model(inputs).clone()
+        torch.testing.assert_close(output[: rows.shape[0]], expected * 2)
+        torch.testing.assert_close(
+            output[rows.shape[0] :],
+            torch.zeros_like(output[rows.shape[0] :]),
+            rtol=0,
+            atol=0,
+        )
+        torch.testing.assert_close(
+            cache[0], torch.full_like(cache[0], 42), rtol=0, atol=0
+        )
+        torch.testing.assert_close(
+            cache[3], torch.full_like(cache[3], 17), rtol=0, atol=0
+        )
+
+    def reference(sequence):
+        return _causal_depthwise_reference(sequence.float(), weight.float()).to(dtype)
+
+    a = torch.tensor([[1, -1], [2, -2]], device="cuda", dtype=dtype)
+    b = torch.tensor([[10, 4], [20, 8]], device="cuda", dtype=dtype)
+    run_batch(
+        _sconv_batch_metadata(
+            decode_slots=[], prefill_slots=[1, 2], prefill_lengths=[2, 2],
+            initial_states=[False, False],
+        ),
+        torch.vstack((a, b)), torch.vstack((reference(a), reference(b))),
+    )
+
+    # Swap request order; a null row must not read or update reserved slot 0.
+    next_a = torch.tensor([[3, -3]], device="cuda", dtype=dtype)
+    next_b = torch.tensor([[30, 12]], device="cuda", dtype=dtype)
+    a = torch.vstack((a, next_a))
+    b = torch.vstack((b, next_b))
+    run_batch(
+        _sconv_batch_metadata(
+            decode_slots=[2, 1, 0], prefill_slots=[], prefill_lengths=[],
+            initial_states=[],
+        ),
+        torch.vstack((next_b, next_a, torch.full_like(next_a, 123))),
+        torch.vstack((reference(b)[-1:], reference(a)[-1:], torch.zeros_like(next_a))),
+    )
+
+    # Mix decoding with a new prefill reusing slot 2: its stale history must
+    # be discarded by has_initial_states=False.
+    next_a = torch.tensor([[4, -4]], device="cuda", dtype=dtype)
+    c = torch.tensor([[5, 1], [6, 2], [7, 3]], device="cuda", dtype=dtype)
+    a = torch.vstack((a, next_a))
+    run_batch(
+        _sconv_batch_metadata(
+            decode_slots=[1], prefill_slots=[2], prefill_lengths=[3],
+            initial_states=[False],
+        ),
+        torch.vstack((next_a, c)), torch.vstack((reference(a)[-1:], reference(c))),
+    )
+    next_c = torch.tensor([[8, 4]], device="cuda", dtype=dtype)
+    c = torch.vstack((c, next_c))
+    next_a = torch.tensor([[5, -5], [6, -6]], device="cuda", dtype=dtype)
+    a = torch.vstack((a, next_a))
+    run_batch(
+        _sconv_batch_metadata(
+            decode_slots=[2], prefill_slots=[1], prefill_lengths=[2],
+            initial_states=[True],
+        ),
+        torch.vstack((next_c, next_a)),
+        torch.vstack((reference(c)[-1:], reference(a)[-2:])),
+    )
+    next_c = torch.tensor([[9, 5]], device="cuda", dtype=dtype)
+    c = torch.vstack((c, next_c))
+    run_batch(
+        _sconv_batch_metadata(
+            decode_slots=[2], prefill_slots=[], prefill_lengths=[], initial_states=[],
+        ),
+        next_c, reference(c)[-1:],
+    )
+    # Every replay reused the captured arithmetic, without capturing another
+    # graph for changed request counts, cache slots, or prefill/decode metadata.
+    cache_before_empty_batch = cache.clone()
+    run_batch(
+        _sconv_batch_metadata(
+            decode_slots=[], prefill_slots=[], prefill_lengths=[], initial_states=[],
+        ),
+        next_c[:0], next_c[:0],
+    )
+    torch.testing.assert_close(cache, cache_before_empty_batch, rtol=0, atol=0)
+    assert compilation_counter.num_cudagraph_captured == captures_after
+
+
